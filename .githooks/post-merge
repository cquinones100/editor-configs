#!/usr/bin/env bash

# After a pull or merge brings in commits, links whatever they added with the
# parts of setup.sh that ask nothing: tmux and bin always, and claude, skills
# and git where this clone already uses them. Then it lists anything the guided setup
# still has left (./setup.sh --check), and nothing when there is none. A pull
# from lazygit or an editor has no terminal to answer questions in, so the
# guided setup itself is left to you; the update popup (tmux/repo-update.sh)
# runs it.
#
# Enabled per clone by `./setup.sh git`, which points core.hooksPath at
# .githooks. post-rewrite runs it after `git pull --rebase`.

set -u

repo=$(git rev-parse --show-toplevel) || exit 0
[ -x "$repo/setup.sh" ] || exit 0

parts=(tmux bin git)
# Switchboard's skills, once any is linked from this clone.
for skill in "$repo"/claude/skills/*/; do
  name=$(basename "$skill")
  [[ -L ~/.claude/skills/$name && ~/.claude/skills/$name -ef $repo/claude/skills/$name ]] && { parts+=(skills); break; }
done
[[ $(readlink ~/.claude/settings.json 2>/dev/null) == */switchboard/claude/settings.json || $(readlink ~/.claude/settings.json 2>/dev/null) == */editor-configs/claude/settings.json ]] && parts+=(claude)

# Silent when everything was already in place.
changed=$("$repo/setup.sh" "${parts[@]}" 2>&1 | grep -v ': up to date$')
left=$("$repo/setup.sh" --check 2>/dev/null | sed -n '/^Left to do:/,$p')
[ -n "$changed" ] && printf 'setup.sh linked what the pull added:\n%s\n' "$(sed 's/^/  /' <<<"$changed")"
[ -n "$left" ] && printf '%s\n' "$left"
exit 0
