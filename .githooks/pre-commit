#!/usr/bin/env bash

# Refuses a commit whose claude/settings.json carries settings that belong to
# one machine rather than to every one this repo is synced to:
#
#   autoMode  the auto mode environment profile, which describes the
#             organization a machine works for. It belongs in that project's
#             .claude/settings.local.json (see CLAUDE.md).
#   model     whatever /model last picked, which Claude Code writes back to
#             the file as it changes. The committed value stays put.
#
# Only what is staged is checked, against HEAD, so the working copy can keep
# both while the rest of the file is committed with `git add -p`.
#
# Enabled per clone by `./sync.sh git`, which points core.hooksPath at
# .githooks. `git commit --no-verify` skips it.

set -u

file=claude/settings.json

git diff --cached --quiet -- "$file" && exit 0

staged=$(git show ":$file" 2>/dev/null) || exit 0
committed=$(git show "HEAD:$file" 2>/dev/null || echo '{}')

# A file jq cannot read is not this hook's business.
has_auto_mode=$(jq 'has("autoMode")' <<<"$staged" 2>/dev/null) || exit 0
staged_model=$(jq -c '.model' <<<"$staged" 2>/dev/null) || exit 0
committed_model=$(jq -c '.model' <<<"$committed" 2>/dev/null) || committed_model=null

problems=()
[ "$has_auto_mode" = true ] &&
  problems+=("it adds an \"autoMode\" block, which describes one machine's environment and belongs in that project's .claude/settings.local.json")
[ "$staged_model" != "$committed_model" ] &&
  problems+=("it changes \"model\" from $committed_model to $staged_model, which Claude Code rewrites whenever /model is used")

[ ${#problems[@]} -eq 0 ] && exit 0

{
  echo "pre-commit: $file can't be committed as staged:"
  printf '  - %s\n' "${problems[@]}"
  echo
  echo "Stage the rest of the file without those lines:"
  echo "  git restore --staged $file && git add -p $file"
} >&2
exit 1
