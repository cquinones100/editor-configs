#!/usr/bin/env node
// Prints the last reply Claude gave in a tmux tab: the final text of its last
// turn, as the Slack relay reads it from the session's transcript.
//
//   claude-reply <window>          the reply, to stdout
//   claude-reply --pane <window>   the pane to type into: the tab's Claude
//                                  pane, or its active pane when it runs none
//
// <window> is a tmux window ID (@12) or index. Used by tmux/reply-send.sh, the
// M-p "Send Claude's last reply to another tab" action. Exits 1, saying why
// on stderr, when the tab has no Claude or no reply yet.

const { claudeTabs, transcriptFor, lastSaid, paneFor } = require("../lib/slack-relay/tabs");
const { tryTmux } = require("../lib/slack-relay/util");

const args = process.argv.slice(2);
const pane = args[0] === "--pane";
const target = pane ? args[1] : args[0];
if (!target) {
  console.error("usage: claude-reply [--pane] <window>");
  process.exit(2);
}
const id = tryTmux(["display-message", "-p", "-t", String(target).startsWith("@") ? target : `:${target}`, "#{window_id}"]);
if (!id) {
  console.error(`No tab ${target}.`);
  process.exit(1);
}
const tab = claudeTabs().find((t) => t.id === id);

if (pane) {
  process.stdout.write(tab ? paneFor(id) : tryTmux(["display-message", "-p", "-t", id, "#{pane_id}"]));
  process.exit(0);
}
if (!tab) {
  console.error("This tab isn't running Claude.");
  process.exit(1);
}
const reply = lastSaid(transcriptFor(id));
if (!reply) {
  console.error("Claude hasn't replied in this tab yet.");
  process.exit(1);
}
process.stdout.write(reply.trim());
