#!/usr/bin/env bash
# notes: the macOS Notes app's notes, in Neovim.
#
# Opens Neovim with your own config and the notes plugin in notes/ added for
# this run only, so your normal nvim is left as it is, and runs :Notes. The
# plugin is added after your config has loaded (with -c, not --cmd), since
# lazy.nvim resets the runtimepath while it starts. g:notes_app is set before
# the config (with --cmd), so it can leave out what has no place in notes:
# Copilot isn't loaded at all. Notes are Markdown files in
# $NOTES_DIR, or ~/Notes. Anything after `notes` is passed to nvim.

#
# It listens on a socket of its own (NOTES_SOCKET), so tmux/notes-open.sh can
# open the note that belongs to a tab when M-e brings Notes beside it. A
# socket left by an app that has gone is removed; one still answering belongs
# to the app already running, which this one will give way to.

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
sock=${NOTES_SOCKET:-$HOME/.local/state/switchboard/notes.sock}
mkdir -p "${sock%/*}"
if [ -S "$sock" ] && ! nvim --server "$sock" --remote-expr 1 >/dev/null 2>&1; then rm -f "$sock"; fi
listen=()
[ -S "$sock" ] || listen=(--listen "$sock")
exec nvim "${listen[@]}" --cmd "let g:notes_app = 1" -c "set rtp^=$here/notes" -c "runtime plugin/notes.lua" -c "Notes" "$@"
