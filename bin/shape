#!/usr/bin/env node

// shape <what the ticket is about>
// shape <linear-ticket-id-or-url>
//
// Starts a Claude session that shapes a Linear ticket with you: it reads the
// code, checks Linear for tickets that already cover it, drafts the ticket,
// and creates or updates it once you approve. The instructions live in the
// /shape skill, so the same thing works inside a session you already have;
// this only gets the session started in the right place.
//
//   shape "people can't tell which phase is active"
//   shape ABC-123        refine an existing ticket
//
// Runs in the repository's main checkout, even when called from a worktree,
// since a ticket being shaped has no branch yet. Fetches first and warns when
// the local main is behind, because Claude reads the files on disk. Inside
// tmux, names the tab "Shaping: <first words>" so it is easy to find; /wt
// clears that name when it hands the tab over to the ticket's worktree.

const { execFileSync, spawnSync } = require("node:child_process");
const path = require("node:path");

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

const usage = () => {
  console.error(
    "Usage: shape <what the ticket is about>\n" +
      "       shape <linear-ticket-id-or-url>\n\n" +
      "Examples:\n" +
      '  shape "people can\'t tell which phase is active"\n' +
      "  shape ABC-123",
  );
  process.exit(1);
};

const git = (args, cwd) =>
  execFileSync("git", args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();

const tryGit = (args, cwd) => {
  try {
    return git(args, cwd);
  } catch {
    return undefined;
  }
};

const ticketIn = (text) =>
  text.match(/\/issue\/([A-Za-z][A-Za-z0-9]*-\d+)/)?.[1] ??
  text.match(/^([A-Za-z][A-Za-z0-9]*-\d+)$/)?.[1];

// The main checkout is the parent of the shared .git directory, which is the
// same answer from the main checkout and from any of its worktrees.
const mainCheckout = () => {
  const common = tryGit(["rev-parse", "--path-format=absolute", "--git-common-dir"]);
  if (!common) fail("not inside a git repository");
  return path.dirname(common);
};

// Read-only: no pull, no checkout. The point is only to say when the code
// Claude is about to read is older than what is on the remote.
const warnIfBehind = (root) => {
  const branch = tryGit(["branch", "--show-current"], root);
  const upstream = tryGit(["rev-parse", "--abbrev-ref", "@{upstream}"], root);
  if (!branch || !upstream) return;
  try {
    execFileSync("git", ["fetch", "--quiet"], { cwd: root, stdio: ["ignore", "ignore", "pipe"], timeout: 20000 });
  } catch {
    console.error("Could not fetch; shaping against the local checkout as it is.");
    return;
  }
  const behind = Number(tryGit(["rev-list", "--count", `${branch}..${upstream}`], root) ?? 0);
  if (behind > 0) {
    console.error(
      `Note: ${branch} is ${behind} commit${behind === 1 ? "" : "s"} behind ${upstream}. ` +
        "Claude reads the files on disk, so update it first if those commits matter here.",
    );
  }
};

// Names the tab in tmux's @tab_name, the same option M-n sets, then renames
// the tabs straight away rather than on the next pane focus.
const nameTab = (label) => {
  const pane = process.env.TMUX_PANE;
  if (!process.env.TMUX || !pane) return;
  try {
    execFileSync("tmux", ["set-option", "-w", "-t", pane, "@tab_name", label], { stdio: "ignore" });
    const session = execFileSync("tmux", ["display-message", "-p", "-t", pane, "#{session_name}"], {
      encoding: "utf8",
    }).trim();
    spawnSync(path.join(process.env.HOME, ".config/tmux/window-names.sh"), [session], { stdio: "ignore" });
  } catch {
    // A tab without a name is no reason to stop.
  }
};

const main = () => {
  const args = process.argv.slice(2);
  if (!args.length || args.includes("--help") || args.includes("-h")) usage();

  const input = args.join(" ").trim();
  const ticket = ticketIn(input);
  const root = mainCheckout();

  warnIfBehind(root);

  const words = input.split(/\s+/).slice(0, 4).join(" ");
  nameTab(`Shaping: ${ticket ? ticket.toUpperCase() : words}${!ticket && input.split(/\s+/).length > 4 ? "..." : ""}`);

  const claude = spawnSync("claude", [`/shape ${ticket ? ticket.toUpperCase() : input}`], {
    cwd: root,
    stdio: "inherit",
  });
  if (claude.error?.code === "ENOENT") fail("claude not found on PATH");
  process.exit(claude.status ?? 0);
};

main();
