#!/usr/bin/env node

// shape-batch <ideas-or-tickets...>
// shape-batch < ideas.txt
//
// Opens one tmux window per idea or ticket and runs `shape` in each, the way
// wt-batch does for `wt`. Each argument is one thing to shape, since an idea is
// free text full of spaces and commas. An argument that is nothing but ticket
// identifiers or Linear URLs is split like wt-batch splits them. With no
// arguments, ideas are read from stdin, one per line.
//
//   shape-batch "phase label is unclear" "results load slowly" ABC-123
//   shape-batch "ABC-123, ABC-124"
//   shape-batch < ideas.txt
//
// The windows sit right after the current one, in the order given. Focus stays
// where it is. Each tab is named "Shaping: ..." by `shape` itself once it
// starts, so /wt can later clear that name when it hands the tab over.
//
// `shape` is typed into each window's interactive shell rather than run as the
// window's command, as wt-batch does with `wt`: the shell is what reads
// ~/.zshrc and so has node on the PATH, and it is still there afterwards.

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");

const usage = () => {
  console.error(
    "Usage: shape-batch <ideas-or-tickets...>\n" +
      "       shape-batch < ideas.txt\n\n" +
      "Each argument is one thing to shape; quote ideas that contain spaces.\n" +
      "Examples:\n" +
      '  shape-batch "phase label is unclear" "results load slowly" ABC-123\n' +
      '  shape-batch "ABC-123, ABC-124"\n' +
      "  shape-batch < ideas.txt",
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

const TICKET = /^(?:[A-Za-z][A-Za-z0-9]*-\d+|https?:\/\/\S*\/issue\/[A-Za-z][A-Za-z0-9]*-\d+\S*)$/;

// "ABC-1, ABC-2" or "ABC-1 https://linear.app/x/issue/ABC-2/title" becomes one
// item per ticket. Anything with a single non-ticket word in it is an idea and
// stays whole.
const itemsFrom = (arg) => {
  const tokens = arg.split(/[\s,]+/).filter(Boolean);
  return tokens.length && tokens.every((token) => TICKET.test(token)) ? tokens : [arg];
};

// What gets typed into the shell, so it is single-quoted, with any single
// quote inside closed, escaped, and reopened. Newlines would end the command
// early, so they become spaces.
const quoted = (text) => `'${text.replace(/\s*\n\s*/g, " ").replace(/'/g, "'\\''")}'`;

const tmux = (args) =>
  execFileSync("tmux", args, { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }).trim();

const main = () => {
  const argv = process.argv.slice(2);
  if (argv.includes("--help") || argv.includes("-h")) usage();

  const fromStdin =
    argv.length === 0 && !process.stdin.isTTY
      ? fs.readFileSync(0, "utf8").split("\n").map((line) => line.trim()).filter(Boolean)
      : [];
  const inputs = argv.length ? argv : fromStdin;
  if (inputs.length === 0) usage();

  if (!process.env.TMUX) fail("not inside a tmux session");

  // Everything is worked out before any window opens, and repeats open once.
  const items = [...new Set(inputs.flatMap(itemsFrom).map((item) => item.trim()).filter(Boolean))];
  if (items.length === 0) usage();

  // Each window goes after the previous one so the order matches the input; a
  // bare `-a` would put every window right after the current one and reverse
  // them.
  items.reduce((after, item) => {
    const windowId = tmux([
      "new-window",
      "-d",
      "-a",
      "-t",
      after,
      "-n",
      "shaping",
      "-c",
      process.cwd(),
      "-P",
      "-F",
      "#{window_id}",
    ]);
    tmux(["send-keys", "-t", windowId, `shape ${quoted(item)}`, "Enter"]);
    console.error(`Shaping ${item.length > 60 ? `${item.slice(0, 57)}...` : item} in window ${windowId}`);
    return windowId;
  }, tmux(["display-message", "-p", "#{window_id}"]));
};

main();
