#!/usr/bin/env node

// slack-relay [start|run|stop]
//
// Relays between your Slack self-DM and the Claude sessions in your tmux tabs,
// for when you are away from the computer. Runs in its own tmux tab.
//
//   slack-relay          open the relay in a tmux tab named "slack-relay", or
//                        go to it if it is already running
//   slack-relay stop     stop it
//   slack-relay run      the relay itself, restarted if it crashes; `start`
//                        runs this in the new tab
//   slack-relay notify [--from <name>] [<text>]
//                        post <text> (else what comes on stdin) in the DM as
//                        the app, so Slack notifies you, through the running
//                        relay; exits 0 once it is posted, 1 if it wasn't
//                        (see outbox.js)
//
// What you can send in the DM:
//   a reply in a tab's thread   typed into that tab's Claude (a tab is never
//                               named in a message; the Home tab's screens and
//                               the buttons reach the others)
//   ? in a tab's thread         that tab's last turn: your prompt and its reply
//   status                      every Claude tab and its state
//   progress in a tab's thread  what that tab is doing, summarized, without typing into it
//   progress                    every tab at once, most urgent first
//   esc in a tab's thread       press Escape in that tab, to stop Claude mid-turn
//   stop                        stop the relay
//   new: <prompt>               starts a new Claude tab with that prompt
//   new <place>: <prompt>       the same, in a repository, a worktree (by ticket
//                               or branch) or a directory
//   anything else               is not acted on; the reply lists the commands
//
// It posts an alert when a tab's Claude is waiting on you or has finished, from
// the state tmux/agent-state.sh keeps on each pane.
//
// The relay is a Slack app of its own, and talks to you in the app's DM: it
// posts through Slack's Web API as the app's bot, and hears you through Socket
// Mode, a connection it opens to Slack, so nothing on this Mac listens for
// connections. Only messages typed by the member named in
// ~/.config/slack-relay/config.json, in that DM, are acted on, and everything
// it writes can only go to that DM (see slack.js). Its tokens are in the
// macOS Keychain. Tab states are read every second, from tmux.
//
// `run` keeps the relay going: it runs the relay as a child process and, if
// that dies, starts it again and says so in the DM, or, after too many crashes
// in a row, says the relay is down. Everything it logs also goes to
// ~/.local/state/slack-relay/relay.log.
//
// Loaded with require() (the tests in test/), it runs nothing and exports its
// parts instead.
//
// The code is in lib/slack-relay/, one file per part: config and util, the
// Slack app (slack), catching up and posting (read, post), the saved state,
// tabs and their transcripts (tabs), the commands you send (commands,
// summaries), what it reports on its own (followups, alerts, stuck,
// milestones, homes, dashboard), and starting and stopping (cli,
// lifecycle, run). This file only picks the command.

const parts = Object.assign({}, 
  require("../lib/slack-relay/alerts"),
  require("../lib/slack-relay/buttons"),
  require("../lib/slack-relay/cleanup"),
  require("../lib/slack-relay/cli"),
  require("../lib/slack-relay/commands"),
  require("../lib/slack-relay/config"),
  require("../lib/slack-relay/dashboard"),
  require("../lib/slack-relay/files"),
  require("../lib/slack-relay/followups"),
  require("../lib/slack-relay/homes"),
  require("../lib/slack-relay/lifecycle"),
  require("../lib/slack-relay/milestones"),
  require("../lib/slack-relay/offline"),
  require("../lib/slack-relay/outbox"),
  require("../lib/slack-relay/places"),
  require("../lib/slack-relay/post"),
  require("../lib/slack-relay/presence"),
  require("../lib/slack-relay/presses"),
  require("../lib/slack-relay/quickreplies"),
  require("../lib/slack-relay/read"),
  require("../lib/slack-relay/run"),
  require("../lib/slack-relay/screens"),
  require("../lib/slack-relay/skills"),
  require("../lib/slack-relay/slack"),
  require("../lib/slack-relay/state"),
  require("../lib/slack-relay/stuck"),
  require("../lib/slack-relay/slices"),
  require("../lib/slack-relay/summaries"),
  require("../lib/slack-relay/tabs"),
  require("../lib/slack-relay/util"),
);

if (require.main === module) {
  const { start, stop } = parts;
  const { fail, supervise, relay, notify } = parts;
  const command = process.argv[2] ?? "start";
  if (command === "start") start();
  else if (command === "stop") stop();
  else if (command === "run") supervise().catch((err) => fail(err.message));
  else if (command === "relay") relay().catch((err) => fail(err.message));
  else if (command === "notify") {
    const args = process.argv.slice(3);
    const at = args.indexOf("--from");
    const from = at === -1 ? undefined : args.splice(at, 2)[1];
    const text = args.length ? args.join(" ") : require("node:fs").readFileSync(0, "utf8");
    // Not fail(): that writes to the relay's log, which is the relay's own.
    notify(text, { from }).then(
      (ts) => console.log(`posted ${ts}`),
      (err) => {
        console.error(`Error: ${err.message}`);
        process.exit(1);
      },
    );
  } else fail(`unknown command "${command}"; use start, stop, run or notify`);
} else {
  module.exports = parts;
}
