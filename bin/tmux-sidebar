#!/usr/bin/env node

// tmux-sidebar [daemon|stop|status]
//
// The tabs as a sidebar on the left of every tmux window, most in need of you
// first, and mission control, a full-screen view of every tab with its latest
// Claude turn. Both are drawn by this one daemon; each sidebar pane and the
// mission control popup run tmux/sidebar-pane.zsh, a zsh client that shows
// what the daemon sends and sends back the keys you press.
//
//   tmux-sidebar daemon   run the daemon (tmux/sidebar.sh starts it in the
//                         background; a second one exits at once)
//   tmux-sidebar stop     stop it; the sidebars wait for the next one
//   tmux-sidebar status   whether it is running, and its pid
//
// Loaded with require() (the tests in test/), it runs nothing and exports its
// parts instead.
//
// The code is in lib/sidebar/, one file per part: config, tmux (reading and
// driving tmux), claude (sessions and their last turns), model (tabs and their
// order), text and render (drawing), keys, panes (keeping a sidebar in every
// window), plugins (and plugins/, the ones kept here), and daemon.

const fs = require("node:fs");
const parts = Object.assign({},
  require("../lib/sidebar/config"),
  require("../lib/sidebar/tmux"),
  require("../lib/sidebar/claude"),
  require("../lib/sidebar/model"),
  require("../lib/sidebar/text"),
  require("../lib/sidebar/render"),
  require("../lib/sidebar/keys"),
  require("../lib/sidebar/panes"),
  require("../lib/sidebar/plugins"),
  require("../lib/sidebar/prs"),
  require("../lib/sidebar/views"),
  require("../lib/sidebar/activity"),
  require("../lib/sidebar/daemon"),
);

if (require.main !== module) {
  module.exports = parts;
} else {
  const pid = () => {
    try {
      const value = Number(fs.readFileSync(parts.LOCK, "utf8"));
      process.kill(value, 0);
      return value;
    } catch {
      return undefined;
    }
  };
  const command = process.argv[2] ?? "daemon";
  if (command === "daemon") {
    if (!parts.start()) process.exit(0);
  } else if (command === "stop") {
    const running = pid();
    if (running) process.kill(running, "SIGTERM");
    console.log(running ? `Stopped ${running}.` : "Not running.");
  } else if (command === "status") {
    const running = pid();
    console.log(running ? `Running, pid ${running}.` : "Not running.");
    process.exit(running ? 0 : 1);
  } else {
    console.error("Usage: tmux-sidebar [daemon|stop|status]");
    process.exit(2);
  }
}
