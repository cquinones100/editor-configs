#!/usr/bin/env node

// update-main [<dir>]
//
// Brings the repository's local default branch (main, as origin/HEAD names it)
// up to date with origin's, from wherever you are: a worktree on another
// branch, or the main clone itself. Nothing is switched, and only a fast
// forward is ever made, so local commits on main are never lost.
//
//   update-main          the repository of the current directory
//   update-main <dir>    the repository <dir> is in
//
// Where main is checked out (usually the main clone), it is fast-forwarded
// there, which moves that checkout's files too, so a checkout with changes not
// committed is left alone and said so. Where it is checked out nowhere, the
// branch is moved without touching any files. Either way, a main with commits
// origin's doesn't have is left as it is.

const { execFileSync } = require("node:child_process");
const path = require("node:path");

const fail = (message) => {
  console.error(`update-main: ${message}`);
  process.exit(1);
};

const git = (args, cwd) => execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const tryGit = (args, cwd) => {
  try {
    return git(args, cwd);
  } catch {
    return undefined;
  }
};

const main = () => {
  const argv = process.argv.slice(2);
  if (argv.includes("--help") || argv.includes("-h") || argv.length > 1) {
    console.error("Usage: update-main [<dir>]");
    process.exit(argv.length > 1 ? 1 : 0);
  }
  const dir = path.resolve(argv[0] ?? process.cwd());
  const common = tryGit(["rev-parse", "--path-format=absolute", "--git-common-dir"], dir);
  if (!common) fail(`not in a git repository: ${dir}`);
  const root = path.dirname(common);
  const remote = (tryGit(["remote"], root) ?? "").split("\n").includes("origin") ? "origin" : (tryGit(["remote"], root) ?? "").split("\n")[0];
  if (!remote) fail("the repository has no remote");
  const branch = (tryGit(["rev-parse", "--abbrev-ref", `${remote}/HEAD`], root) ?? `${remote}/main`).replace(`${remote}/`, "");

  try {
    execFileSync("git", ["-C", root, "fetch", "--quiet", remote, `+refs/heads/${branch}:refs/remotes/${remote}/${branch}`], { stdio: ["ignore", "ignore", "inherit"] });
  } catch {
    fail(`could not fetch ${branch} from ${remote}`);
  }
  const theirs = git(["rev-parse", `${remote}/${branch}`], root);
  const ours = tryGit(["rev-parse", `refs/heads/${branch}`], root);
  const short = (sha) => sha.slice(0, 9);
  const count = (from, to) => git(["rev-list", "--count", `${from}..${to}`], root);

  if (ours === theirs) return console.log(`${branch} is up to date with ${remote} (${short(theirs)}).`);
  if (ours && tryGit(["merge-base", "--is-ancestor", ours, theirs], root) === undefined) {
    fail(`${branch} has ${count(theirs, ours)} commit(s) ${remote}/${branch} doesn't, so it was left as it is.`);
  }

  // The worktree main is checked out in, if any.
  const checkedOut = git(["worktree", "list", "--porcelain"], root)
    .split("\n\n")
    .find((entry) => entry.includes(`\nbranch refs/heads/${branch}`))
    ?.match(/^worktree (.*)$/m)?.[1];
  const behind = ours ? count(ours, theirs) : "all";
  if (checkedOut) {
    if (git(["status", "--porcelain", "--untracked-files=no"], checkedOut)) {
      fail(`${branch} is checked out in ${checkedOut}, which has changes not committed, so it was left at ${short(ours)}, ${behind} commit(s) behind.`);
    }
    git(["merge", "--ff-only", "--quiet", `${remote}/${branch}`], checkedOut);
  } else {
    git(["update-ref", `refs/heads/${branch}`, theirs, ...(ours ? [ours] : [])], root);
  }
  console.log(`${branch}: ${ours ? short(ours) : "(none)"} → ${short(theirs)}, ${behind} commit(s) from ${remote}${checkedOut ? `, in ${checkedOut}` : ""}.`);
};

main();
