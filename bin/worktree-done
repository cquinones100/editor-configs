#!/usr/bin/env node

// worktree-done [--list] [--all] [--paths]
//
// Reads every worktree in the repo, pulls the Linear ticket each one is named
// after, and offers up the ones whose ticket is finished — completed, merged,
// deployed, canceled, whatever the team's workflow calls it — in an fzf
// multi-select that removes what you pick. The answer to "which of these forty
// directories can I delete", and the deleting.
//
// Removal is `git worktree remove` without --force, same as wt-cleanup, so a
// worktree holding uncommitted work refuses to go rather than losing it. The
// branch always survives; only the checkout is removed.
//
// Needs fzf, and a Linear personal API key (https://linear.app/settings/api)
// from either LINEAR_API_KEY or ~/.config/worktree-from-ticket/config.json —
// the same key worktree-from-ticket already uses.
//
//   worktree-done            pick finished worktrees to remove
//   worktree-done --list     print them instead, removing nothing
//   worktree-done --all      print every worktree grouped by state (implies --list)
//   worktree-done --paths    print only the finished worktree paths, for pipes
//
// C-a in the picker takes everything the query matches; taking the whole list
// at once asks for a y before anything goes.
//
// Without a terminal, or without fzf, it prints rather than prompting — there
// is no picker to draw, and silently removing nothing would look like a bug.
//
// Status goes to stderr so --paths output stays pipeable on stdout.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const LINEAR_API = "https://api.linear.app/graphql";

// Linear's own vocabulary for "this issue is over". Every other type
// (triage, backlog, unstarted, started) means the work is still live.
const DONE_TYPES = new Set(["completed", "canceled"]);

// Comfortably under Linear's 250 page cap, so one query per chunk always
// returns every match rather than silently paginating.
const CHUNK_SIZE = 100;

const CONFIG_PATH = path.join(
  process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config"),
  "worktree-from-ticket",
  "config.json",
);

const usage = () => {
  console.error(
    "Usage: worktree-done [--list] [--all] [--paths]\n\n" +
      "Picks finished worktrees out of an fzf multi-select and removes them.\n\n" +
      "  --list   print them instead, removing nothing\n" +
      "  --all    print every worktree grouped by ticket state (implies --list)\n" +
      "  --paths  print only the finished worktrees' paths, one per line\n\n" +
      "Keys in the picker:\n" +
      "  Tab        toggle selection\n" +
      "  C-a        select everything the query matches, and accept\n" +
      "  Enter      confirm and remove selected\n" +
      "  Esc / C-c  cancel\n\n" +
      "Taking every worktree at once asks first.\n",
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

const status = (message) => console.error(message);

const readApiKey = () => {
  if (process.env.LINEAR_API_KEY) return process.env.LINEAR_API_KEY;

  const fromConfig = (() => {
    try {
      return JSON.parse(fs.readFileSync(CONFIG_PATH, "utf8")).linearApiKey;
    } catch {
      return undefined;
    }
  })();
  if (fromConfig) return fromConfig;

  fail(
    "no Linear API key found. Create a personal key at\n" +
      "  https://linear.app/settings/api\n" +
      "then either export it:\n" +
      '  export LINEAR_API_KEY="lin_api_..."\n' +
      `or save it to ${CONFIG_PATH}:\n` +
      `  mkdir -p ${path.dirname(CONFIG_PATH)}\n` +
      `  printf '{"linearApiKey":"lin_api_..."}' > ${CONFIG_PATH}\n` +
      `  chmod 600 ${CONFIG_PATH}`,
  );
};

const gitOutput = (args, options = {}) =>
  execFileSync("git", args, { encoding: "utf8", ...options }).trim();

// --git-common-dir rather than --show-toplevel: inside an existing worktree the
// latter returns that worktree, and `worktree list` wants the main repo.
const repoRoot = () => {
  try {
    return path.resolve(gitOutput(["rev-parse", "--git-common-dir"]), "..");
  } catch {
    fail("not inside a git repository");
  }
};

const listWorktrees = (root) => {
  const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
    cwd: root,
    encoding: "utf8",
  });

  // Records are blank-line separated; `worktree <path>` opens each one and
  // `branch refs/heads/<name>` appears in it only when a branch is checked out.
  return porcelain
    .split("\n\n")
    .map((record) => record.split("\n"))
    .map((lines) => ({
      path: lines.find((line) => line.startsWith("worktree "))?.slice(9),
      branch: lines
        .find((line) => line.startsWith("branch refs/heads/"))
        ?.slice("branch refs/heads/".length),
    }))
    .filter((worktree) => worktree.path)
    // The main clone is never a cleanup candidate — git will not remove it and
    // its branch is usually the trunk — so it is not one of the worktrees this
    // question is being asked about.
    .filter((worktree) => worktree.path !== root);
};

// Anchored on a word boundary so the number belongs to the key beside it, and
// applied to the branch before the directory: `wt` names both after the ticket,
// but `wtpr` names the directory `pr-<n>-<branch>` and only the branch half can
// carry a ticket. The `pr-<n>` prefix is stripped first regardless, so a PR
// number is never read as team "PR".
const findIdentifier = (text) => {
  if (!text) return undefined;
  const cleaned = text.toLowerCase().replace(/^pr-\d+-/, "");
  const match = cleaned.match(/(?:^|[^a-z0-9])([a-z][a-z0-9]*)-(\d+)(?:[^a-z0-9]|$)/);
  return match
    ? { key: match[1].toUpperCase(), number: Number(match[2]) }
    : undefined;
};

const identifierFor = (worktree) =>
  findIdentifier(worktree.branch) ?? findIdentifier(path.basename(worktree.path));

const chunk = (items, size) =>
  items.reduce(
    (chunks, item, index) =>
      index % size === 0
        ? [...chunks, [item]]
        : [...chunks.slice(0, -1), [...chunks.at(-1), item]],
    [],
  );

// One request per chunk rather than one per ticket: forty worktrees is forty
// round trips otherwise, and this is a command you run while deciding whether
// to keep waiting.
const fetchIssues = async (identifiers, apiKey) => {
  const query = `
    query Issues($filters: [IssueFilter!]) {
      issues(filter: { or: $filters }, first: ${CHUNK_SIZE + 50}) {
        nodes { identifier title url state { name type } }
      }
    }`;

  const pages = await Promise.all(
    chunk(identifiers, CHUNK_SIZE).map(async (batch) => {
      const filters = batch.map(({ key, number }) => ({
        and: [{ number: { eq: number } }, { team: { key: { eq: key } } }],
      }));

      const response = await fetch(LINEAR_API, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: apiKey,
        },
        body: JSON.stringify({ query, variables: { filters } }),
      });

      if (!response.ok) {
        fail(
          `Linear API request failed: ${response.status} ${response.statusText}`,
        );
      }

      const payload = await response.json();
      if (payload.errors) {
        fail(
          `Linear API error: ${payload.errors.map((e) => e.message).join("; ")}`,
        );
      }
      return payload.data?.issues?.nodes ?? [];
    }),
  );

  // Keyed by identifier because the filter is an unordered `or` — results come
  // back in whatever order Linear likes, and issues that no longer exist (or
  // that this key cannot see) simply do not come back at all.
  return new Map(pages.flat().map((issue) => [issue.identifier, issue]));
};

const truncate = (text, width) =>
  text.length > width ? `${text.slice(0, Math.max(width - 1, 0))}…` : text;

// Dimmed rather than aligned under the title: worktree paths here run to
// seventy characters, and indenting them past an identifier and a state name
// would push most of them off the edge of the terminal.
const dim = (text) =>
  process.stdout.isTTY ? `\x1b[2m${text}\x1b[0m` : text;

const printGroup = (title, entries, root) => {
  if (!entries.length) return;

  // `||` rather than `??`: a pty with no size reports 0 columns, which is not
  // a width to lay anything out against.
  const width = Math.max((process.stdout.columns || 100) - 2, 40);
  const withIssue = entries.filter((entry) => entry.issue);
  const idWidth = Math.max(
    0,
    ...withIssue.map((entry) => entry.issue.identifier.length),
  );
  const stateWidth = Math.max(
    0,
    ...withIssue.map((entry) => entry.issue.state.name.length),
  );

  console.log(`\n${title} (${entries.length})`);
  entries.forEach(({ issue, worktree }) => {
    const rel = path.relative(root, worktree.path);

    // Nothing to say about a worktree with no ticket beyond where it is, so it
    // gets the path alone rather than a row of empty columns.
    if (!issue) {
      console.log(`  ${truncate(rel, width - 2)}`);
      return;
    }

    const columns =
      `${issue.identifier.padEnd(idWidth)}  ` +
      `${issue.state.name.padEnd(stateWidth)}  ${issue.title}`;
    console.log(`  ${truncate(columns, width - 2)}`);
    console.log(dim(`    ${truncate(rel, width - 4)}`));
  });
};

// Only ever suggested when every finished worktree sits under one directory,
// since that is the single argument wt-cleanup takes.
const commonParent = (entries, root) => {
  const parents = new Set(
    entries.map((entry) => path.dirname(path.relative(root, entry.worktree.path))),
  );
  return parents.size === 1 ? [...parents][0] : undefined;
};

const hasFzf = () => {
  try {
    execFileSync("fzf", ["--version"], { stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
};

// Tab-delimited with --with-nth=1 so the path travels alongside each row
// without being displayed or searched: the visible column is what the eye
// needs, the hidden one is what git needs. Same shape wt-cleanup uses.
const selectViaFzf = (entries, root) => {
  const idWidth = Math.max(...entries.map((e) => e.issue.identifier.length));
  const stateWidth = Math.max(...entries.map((e) => e.issue.state.name.length));
  const nameWidth = Math.max(
    ...entries.map((e) => path.basename(e.worktree.path).length),
  );

  const lines = entries.map((entry) => {
    const display =
      `${entry.issue.identifier.padEnd(idWidth)}  ` +
      `${entry.issue.state.name.padEnd(stateWidth)}  ` +
      `${path.basename(entry.worktree.path).padEnd(nameWidth)}  ` +
      entry.issue.title;
    return [display, entry.worktree.path].join("\t");
  });

  const result = spawnSync(
    "fzf",
    [
      "--multi",
      "--delimiter=\t",
      "--with-nth=1",
      "--nth=1",
      "--prompt=finished worktrees to remove > ",
      "--header=Tab: toggle  C-a: all  Enter: remove selected  Esc: cancel",
      "--height=60%",
      "--reverse",
      // select-all rather than a key fzf reports back: it selects what the
      // current query matches, so narrowing to `abc-6` and hitting C-a takes
      // those and not all forty. Costs fzf's default C-a
      // (beginning-of-line) in the query, which is a short field here.
      "--bind=ctrl-a:select-all+accept",
    ],
    {
      input: lines.join("\n"),
      stdio: ["pipe", "pipe", "inherit"],
      encoding: "utf8",
    },
  );

  if (result.status !== 0) return [];

  const chosen = new Set(
    result.stdout
      .split("\n")
      .filter(Boolean)
      .map((line) => line.split("\t")[1]),
  );
  return entries.filter((entry) => chosen.has(entry.worktree.path));
};

// Read from /dev/tty rather than stdin: stdin may be a pipe even when there is
// a terminal to draw on (fzf opens /dev/tty for the same reason), and a piped
// "y" answering a question about removing everything is not consent.
// Read synchronously off a bare descriptor rather than through readline: a
// stream on /dev/tty holds the event loop open after the answer arrives, and
// the command would sit there having already said what it was going to do.
const confirm = (question) => {
  let fd;
  try {
    fd = fs.openSync("/dev/tty", "r");
  } catch {
    status("No terminal to confirm on — nothing removed.");
    return false;
  }

  process.stderr.write(`${question} `);
  const buffer = Buffer.alloc(64);

  try {
    // A tty opened non-blocking answers EAGAIN until the line is typed, which
    // is a wait rather than a failure.
    for (;;) {
      try {
        const bytes = fs.readSync(fd, buffer, 0, buffer.length, null);
        return /^y(es)?$/i.test(buffer.subarray(0, bytes).toString().trim());
      } catch (err) {
        if (err.code !== "EAGAIN") throw err;
      }
    }
  } catch {
    return false;
  } finally {
    fs.closeSync(fd);
  }
};

// No --force, deliberately: git refuses to remove a worktree with uncommitted
// changes or untracked files, which is the only thing standing between a
// mistaken selection and lost work. A refusal is reported and the run carries
// on to the rest of the selection.
const removeWorktrees = (entries, root) => {
  const failures = entries.filter((entry) => {
    const rel = path.relative(root, entry.worktree.path);
    status(`Removing ${rel}...`);
    const { status: code } = spawnSync(
      "git",
      ["-C", root, "worktree", "remove", entry.worktree.path],
      { stdio: "inherit" },
    );
    if (code === 0) return false;
    status(
      `  failed — run 'git -C ${root} worktree remove --force ${rel}' if that is intended`,
    );
    return true;
  });

  status(
    `\nRemoved ${entries.length - failures.length} of ${entries.length}` +
      `${failures.length ? `, ${failures.length} left in place` : ""}.`,
  );
  return failures.length;
};

const main = async () => {
  const argv = process.argv.slice(2);
  if (argv.includes("--help") || argv.includes("-h")) usage();

  const showAll = argv.includes("--all");
  const pathsOnly = argv.includes("--paths");
  const unknown = argv.filter(
    (arg) => !["--all", "--paths", "--list"].includes(arg),
  );
  if (unknown.length) {
    console.error(`Unknown argument: ${unknown[0]}`);
    usage();
  }

  // --all is a listing modifier, so it implies --list: it exists to show the
  // worktrees this tool will not offer to remove, which is a thing to read
  // rather than to act on.
  const listOnly = argv.includes("--list") || showAll;

  const root = repoRoot();
  const worktrees = listWorktrees(root);

  if (!worktrees.length) {
    status(`No worktrees besides the main clone in ${root}`);
    return;
  }

  const tagged = worktrees.map((worktree) => ({
    worktree,
    identifier: identifierFor(worktree),
  }));
  const identified = tagged.filter((entry) => entry.identifier);

  status(
    `Checking ${identified.length} of ${worktrees.length} worktree${worktrees.length === 1 ? "" : "s"} ` +
      `against Linear`,
  );

  // Deduplicated: two worktrees on the same ticket — the ticket's own and the
  // one made later from its PR — should not be asked about twice.
  const unique = [
    ...new Map(
      identified.map(({ identifier }) => [
        `${identifier.key}-${identifier.number}`,
        identifier,
      ]),
    ).values(),
  ];

  const issues = identified.length
    ? await fetchIssues(unique, readApiKey())
    : new Map();

  const entries = tagged.map(({ worktree, identifier }) => ({
    worktree,
    issue: identifier
      ? issues.get(`${identifier.key}-${identifier.number}`)
      : undefined,
  }));

  const done = entries.filter((entry) => DONE_TYPES.has(entry.issue?.state.type));

  if (pathsOnly) {
    done.forEach((entry) => console.log(entry.worktree.path));
    status(`${done.length} finished`);
    return;
  }

  const open = entries.filter(
    (entry) => entry.issue && !DONE_TYPES.has(entry.issue.state.type),
  );
  const missing = entries.filter((entry) => !entry.issue);

  const summarise = () => {
    if (open.length) status(`${open.length} still open (--all to list)`);
    if (missing.length) {
      status(`${missing.length} with no ticket found (--all to list)`);
    }
  };

  if (!done.length) {
    status("Nothing finished — every worktree is still live.");
    summarise();
    return;
  }

  // Drawn rather than printed whenever there is a terminal to draw on. The
  // printed form stays for pipes, for --list, and for anywhere fzf is missing,
  // since a picker that cannot appear must not silently remove nothing.
  const interactive = !listOnly && process.stdout.isTTY && hasFzf();
  if (!listOnly && process.stdout.isTTY && !interactive) {
    status("fzf is not installed, so this is a listing. Install it to remove.");
  }

  if (!interactive) {
    printGroup("Done", done, root);
    if (showAll) {
      printGroup("Still open", open, root);
      printGroup("No ticket found", missing, root);
    } else {
      console.log("");
      summarise();
    }

    const parent = commonParent(done, root);
    if (parent && !listOnly) {
      status(`\nRemove them with:\n  wt-cleanup ${parent}`);
    }
    return;
  }

  status(`${done.length} finished`);
  summarise();

  const selected = selectViaFzf(done, root);
  if (!selected.length) {
    status("Nothing selected.");
    return;
  }

  // Taking the whole list at once is the one selection worth a second look,
  // whether it arrived by C-a or by holding Tab down. Anything short of all of
  // them was chosen row by row and speaks for itself.
  if (selected.length === done.length && done.length > 1) {
    const ok = confirm(`Remove all ${done.length} finished worktrees? [y/N]`);
    if (!ok) {
      status("Cancelled.");
      return;
    }
  }

  if (removeWorktrees(selected, root)) process.exit(1);
};

main().catch((err) => fail(err.message));
