#!/usr/bin/env node

// worktree-from-branch [path] <branch>
//
// Creates a git worktree on any branch and opens claude in it: the branch as it
// is when it exists here or on the remote, else a new one off the remote's
// default branch, fetched first. <path> defaults to .claude/worktrees, resolved
// against the main repo root so this works from inside an existing worktree.
//
// Plain git: no Linear key, no gh.
//
//   worktree-from-branch my-branch           creates the worktree, opens claude
//   worktree-from-branch init zsh            prints the `wtb` shell function
//
// The bare command cannot change your shell's directory — no child process can.
// Eval the `init` output to get a `wtb` wrapper that also cd's you in.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const DEFAULT_WORKTREE_DIR = ".claude/worktrees";
const SELF = fs.realpathSync(process.argv[1]);

const usage = () => {
  console.error(
    "Usage: worktree-from-branch [path] <branch>\n" +
      "       worktree-from-branch init <zsh|bash>\n\n" +
      "Examples:\n" +
      "  worktree-from-branch fix-login-redirect\n" +
      "  worktree-from-branch .worktrees fix-login-redirect\n" +
      `\nPath defaults to ${DEFAULT_WORKTREE_DIR} under the repo root.`,
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Emitted for `eval "$(worktree-from-branch init zsh)"`. The function is named
// `wtb` rather than `worktree-from-branch` so it can't shadow this script and
// recurse into itself.
//
// It runs the script with --no-claude, cd's, and launches claude itself, as
// `wt` and `wtpr` do, and renames the tabs once it has cd'd, as `wt` does, so
// the tab takes the branch's name now rather than on the next focus.
//
// `rc`, not `status`: `status` is a read-only special variable in zsh.
const shellFunction = () => `wtb() {
  local cdfile rc dir
  cdfile=$(mktemp) || return 1
  ${SELF} --no-claude --cd-file "$cdfile" "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$cdfile"
    return $rc
  fi
  dir=$(sed -n 1p "$cdfile")
  rm -f "$cdfile"
  if [ ! -d "$dir" ]; then
    echo "wtb: expected a worktree directory, got: $dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  if [ -n "$TMUX_PANE" ]; then
    ~/.config/tmux/window-names.sh "$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')"
  fi
  claude
}`;

// Two helpers because execFileSync returns null when stdout isn't piped, so a
// single trim()-ing wrapper would throw on the inherit-stdio calls.
const gitOutput = (args, options = {}) =>
  execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], ...options }).trim();

const gitRun = (args, options = {}) =>
  execFileSync("git", args, { stdio: "ignore", ...options });

// --git-common-dir rather than --show-toplevel: inside an existing worktree the
// latter returns that worktree, and new worktrees belong beside the main repo.
const repoRoot = () => {
  try {
    return path.resolve(gitOutput(["rev-parse", "--git-common-dir"]), "..");
  } catch {
    fail("not inside a git repository");
  }
};

// Flat, slashes made dashes: a branch like feature/login would otherwise nest
// its worktree inside a shared feature/ directory, as worktree-from-pr notes.
const worktreeNameFor = (branch) => branch.replace(/\//g, "-");

const worktreeHoldingBranch = (branch, root) => {
  const porcelain = gitOutput(["worktree", "list", "--porcelain"], { cwd: root });
  const found = porcelain
    .split("\n\n")
    .map((record) => record.split("\n"))
    .find((lines) => lines.includes(`branch refs/heads/${branch}`));
  return found?.find((line) => line.startsWith("worktree "))?.slice(9);
};

// undefined for a repository with no remote: the branch is then made off HEAD.
const defaultRemote = (root) => {
  const remotes = gitOutput(["remote"], { cwd: root }).split("\n").filter(Boolean);
  return remotes.includes("origin") ? "origin" : remotes[0];
};

const branchExists = (branch, root) => {
  try {
    gitRun(["show-ref", "--verify", "--quiet", `refs/heads/${branch}`], { cwd: root });
    return true;
  } catch {
    return false;
  }
};

// An explicit refspec so the remote-tracking ref is always written, whatever
// the remote's configured refspec is. Returns whether the remote has the branch.
const fetchBranch = (branch, remote, root) => {
  try {
    gitRun(["fetch", remote, `+refs/heads/${branch}:refs/remotes/${remote}/${branch}`], {
      cwd: root,
      stdio: ["inherit", 2, "ignore"],
    });
    return true;
  } catch {
    return false;
  }
};

// The remote's default branch, from refs/remotes/<remote>/HEAD, else main or
// master, whichever the remote has.
const defaultBranch = (remote, root) => {
  try {
    return gitOutput(["symbolic-ref", "--short", `refs/remotes/${remote}/HEAD`], { cwd: root }).slice(remote.length + 1);
  } catch {
    return ["main", "master"].find((name) => fetchBranch(name, remote, root));
  }
};

// Written by hand rather than via `worktree add --track`, as worktree-from-pr
// explains: --track fails when the remote's refspec doesn't cover the branch.
const setUpstream = (branch, remote, root) => {
  gitRun(["config", `branch.${branch}.remote`, remote], { cwd: root });
  gitRun(["config", `branch.${branch}.merge`, `refs/heads/${branch}`], { cwd: root });
};

// Claude Code reads .claude/settings.local.json from the worktree root, and git
// never copies it because it is gitignored, so the main clone's is linked in.
const linkLocalSettings = (root, worktreePath) => {
  const source = path.join(root, ".claude", "settings.local.json");
  const target = path.join(worktreePath, ".claude", "settings.local.json");
  if (!fs.existsSync(source) || fs.existsSync(target)) return;
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.symlinkSync(source, target);
};

const addWorktree = (args, root) => {
  try {
    // git's stdout to fd 2 so it can't pollute anything a caller parses.
    gitRun(["worktree", "add", ...args], { cwd: root, stdio: ["inherit", 2, "inherit"] });
  } catch {
    fail("git worktree creation failed (see output above)");
  }
};

const createWorktree = (worktreePath, branch, root) => {
  const remote = defaultRemote(root);
  const onRemote = remote ? fetchBranch(branch, remote, root) : false;

  // A local branch keeps its own commits, caught up with the remote's when it
  // only falls behind; --ff-only so unpushed work is reported, never rewritten.
  if (branchExists(branch, root)) {
    addWorktree([worktreePath, branch], root);
    if (!onRemote) return;
    try {
      gitRun(["merge", "--ff-only", `${remote}/${branch}`], { cwd: worktreePath });
    } catch {
      console.error(`Note: ${branch} has diverged from ${remote}/${branch} and was left as-is.`);
    }
    return;
  }

  if (onRemote) {
    addWorktree(["-b", branch, worktreePath, `${remote}/${branch}`], root);
    setUpstream(branch, remote, root);
    return;
  }

  // A new branch, off the remote's default branch as it is now, with no
  // upstream until its first push.
  const base = remote && defaultBranch(remote, root);
  if (base) fetchBranch(base, remote, root);
  const start = base ? `${remote}/${base}` : "HEAD";
  console.error(`New branch, off ${start}.`);
  addWorktree(["--no-track", "-b", branch, worktreePath, start], root);
};

const main = () => {
  const argv = process.argv.slice(2);

  if (argv[0] === "init") {
    const shell = argv[1];
    if (!["zsh", "bash"].includes(shell)) {
      fail("init requires a shell: worktree-from-branch init <zsh|bash>");
    }
    console.log(shellFunction());
    return;
  }

  if (argv.includes("--help") || argv.includes("-h")) usage();

  const cdFileIndex = argv.indexOf("--cd-file");
  const cdFile = cdFileIndex === -1 ? undefined : argv[cdFileIndex + 1];
  if (cdFileIndex !== -1 && !cdFile) fail("--cd-file requires a path");

  const noClaude = argv.includes("--no-claude");

  // A Set of consumed indexes, so an absent --cd-file (index -1) can't swallow
  // argv[0] the way an `index !== cdFileIndex + 1` comparison would.
  const consumed = new Set(cdFileIndex === -1 ? [] : [cdFileIndex, cdFileIndex + 1]);
  const positional = argv.filter((arg, index) => !consumed.has(index) && arg !== "--no-claude");

  // One positional is the branch; two means an explicit path came first.
  const [targetPath, branch] =
    positional.length === 1 ? [DEFAULT_WORKTREE_DIR, positional[0]] : [positional[0], positional[1]];
  if (!branch) usage();
  try {
    gitRun(["check-ref-format", "--branch", branch]);
  } catch {
    fail(`not a valid branch name: ${branch}`);
  }

  const root = repoRoot();
  const worktreePath = path.resolve(root, targetPath, worktreeNameFor(branch));

  console.error(`Branch:   ${branch}`);

  // Reused rather than refused, so a rerun reopens it. The main clone is not
  // somewhere to send anyone: git allows a branch in one worktree at a time.
  const existing = fs.existsSync(worktreePath)
    ? (console.error("Worktree already exists, reusing it."), worktreePath)
    : worktreeHoldingBranch(branch, root);
  if (existing === root) {
    fail(
      `${branch} is already checked out in your main clone:\n  ${root}\n` +
        "Git allows a branch in only one worktree at a time. Either work there,\n" +
        `or switch that checkout away and rerun:\n  git -C ${root} switch <some-other-branch>`,
    );
  }
  if (existing && existing !== worktreePath) console.error("Branch is already checked out elsewhere, using that.");

  const finalPath = existing ?? worktreePath;
  console.error(`Worktree: ${finalPath}`);

  if (!existing) createWorktree(worktreePath, branch, root);
  linkLocalSettings(root, finalPath);

  // Read by the `wtb` shell function.
  if (cdFile) fs.writeFileSync(cdFile, `${finalPath}\n`);

  // `wtb` launches claude itself, after cd'ing.
  if (noClaude) return;

  const claude = spawnSync("claude", [], { cwd: finalPath, stdio: "inherit" });
  if (claude.error?.code === "ENOENT") {
    console.error(`\nclaude not found on PATH. The worktree is ready at:\n  ${finalPath}`);
    return;
  }
  if (claude.status) process.exit(claude.status);
};

main();
