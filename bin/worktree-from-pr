#!/usr/bin/env node

// worktree-from-pr [path] <pr-number-or-url>
//
// Creates a git worktree on the head branch of a GitHub pull request and opens
// claude in it. <path> defaults to .claude/worktrees, resolved against the main
// repo root so this works from inside an existing worktree.
//
// A fork's PR is set up as `gh pr checkout` sets it up: the fork becomes a
// remote named after its owner, and the worktree's branch, <owner>-<branch>,
// tracks the fork's, so a push updates the PR. A PR's state doesn't matter:
// a merged or closed one whose branch the remote has since deleted is opened
// from the commits GitHub keeps for it (refs/pull/<n>/head), on a local branch
// of the same name with no upstream.
//
// Needs the gh CLI, authenticated (https://cli.github.com), to turn a PR into
// a branch name. Everything after that is plain git.
//
//   worktree-from-pr 123                         creates the worktree, opens claude
//   worktree-from-pr https://github.com/o/r/pull/123
//   worktree-from-pr init zsh                    prints the `wtpr` shell function
//
// The bare command cannot change your shell's directory — no child process can.
// Eval the `init` output to get a `wtpr` wrapper that also cd's you in.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const DEFAULT_WORKTREE_DIR = ".claude/worktrees";
const SELF = fs.realpathSync(process.argv[1]);

const usage = () => {
  console.error(
    "Usage: worktree-from-pr [path] <pr-number-or-url>\n" +
      "       worktree-from-pr init <zsh|bash>\n\n" +
      "Examples:\n" +
      "  worktree-from-pr 123\n" +
      "  worktree-from-pr https://github.com/owner/repo/pull/123\n" +
      "  worktree-from-pr .worktrees 123\n" +
      `\nPath defaults to ${DEFAULT_WORKTREE_DIR} under the repo root.`,
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Emitted for `eval "$(worktree-from-pr init zsh)"`. The function is named
// `wtpr` rather than `worktree-from-pr` so it can't shadow this script and
// recurse into itself.
//
// It runs the script with --no-claude, cd's, and launches claude itself. Doing
// the cd first means the shell sits in the worktree for the whole session, so
// new tmux panes and splits inherit it; if claude ran inside the script the cd
// could only happen after it exited.
//
// The path comes back via --cd-file rather than stdout because $( ) would make
// stdout a pipe, and anything interactive downstream would see a non-TTY.
//
// `rc`, not `status`: `status` is a read-only special variable in zsh.
const shellFunction = () => `wtpr() {
  local cdfile rc dir
  cdfile=$(mktemp) || return 1
  ${SELF} --no-claude --cd-file "$cdfile" "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$cdfile"
    return $rc
  fi
  dir=$(sed -n 1p "$cdfile")
  rm -f "$cdfile"
  if [ ! -d "$dir" ]; then
    echo "wtpr: expected a worktree directory, got: $dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  # WTPR_PROMPT, when set, is Claude's first prompt there (mission control's
  # CI view starts /ci-loop this way).
  if [ -n "\${WTPR_PROMPT:-}" ]; then claude "$WTPR_PROMPT"; else claude; fi
}`;

// gh accepts a number or a URL, so the URL is passed through untouched. Its
// repository is kept too: a PR in another repository is refused (see main).
const parsePr = (input) => {
  const fromUrl = input.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
  if (fromUrl) return { ref: input, number: Number(fromUrl[3]), repo: `${fromUrl[1]}/${fromUrl[2]}` };

  const bare = input.match(/^#?(\d+)$/);
  if (bare) return { ref: bare[1], number: Number(bare[1]) };

  fail(`could not parse a pull request number or URL from "${input}"`);
};

const looksLikePr = (input) =>
  /github\.com\/[^/]+\/[^/]+\/pull\/\d+/.test(input) || /^#?\d+$/.test(input);

const slugify = (text) =>
  text
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "-")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");

// Two helpers because execFileSync returns null when stdout isn't piped, so a
// single trim()-ing wrapper would throw on the inherit-stdio calls.
const gitOutput = (args, options = {}) =>
  execFileSync("git", args, { encoding: "utf8", ...options }).trim();

const gitRun = (args, options = {}) =>
  execFileSync("git", args, { stdio: "ignore", ...options });

// --git-common-dir rather than --show-toplevel: inside an existing worktree the
// latter returns that worktree, and new worktrees belong beside the main repo.
// Undefined outside a repository.
const repoRoot = (cwd) => {
  try {
    return path.resolve(cwd ?? process.cwd(), gitOutput(["rev-parse", "--git-common-dir"], { cwd, stdio: ["ignore", "pipe", "ignore"] }), "..");
  } catch {
    return undefined;
  }
};

// The GitHub owner/name a clone's remote points at, or undefined.
const remoteRepo = (root) => {
  try {
    // Not defaultRemote, which ends the run when a repository has none.
    const remotes = gitOutput(["remote"], { cwd: root, stdio: ["ignore", "pipe", "ignore"] }).split("\n").filter(Boolean);
    const remote = remotes.includes("origin") ? "origin" : remotes[0];
    if (!remote) return undefined;
    // As configured, before any insteadOf rewrite: the name it stands for.
    const url = gitOutput(["config", "--get", `remote.${remote}.url`], { cwd: root, stdio: ["ignore", "pipe", "ignore"] });
    const m = url.match(/github\.com[:/]([^/]+)\/([^/]+?)(?:\.git)?\/?$/);
    return m ? `${m[1]}/${m[2]}` : undefined;
  } catch {
    return undefined;
  }
};

// A clone of owner/name among the repositories you work in: every open tmux
// pane's, every one a Claude session ran in lately (as wt-revive's cache has
// them), and the directories right under your home. Its main clone, not a
// worktree of it.
const findClone = (repo) => {
  const home = os.homedir();
  const dirs = new Set();
  try {
    execFileSync("tmux", ["list-panes", "-a", "-F", "#{pane_current_path}"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).split("\n").forEach((d) => d && dirs.add(d));
  } catch {}
  try {
    Object.values(JSON.parse(fs.readFileSync(path.join(home, ".cache/wt-revive/index.json"), "utf8")).transcripts ?? {}).forEach((t) => t.cwd && dirs.add(t.cwd));
  } catch {}
  try {
    fs.readdirSync(home, { withFileTypes: true }).filter((e) => e.isDirectory() && fs.existsSync(path.join(home, e.name, ".git"))).forEach((e) => dirs.add(path.join(home, e.name)));
  } catch {}
  // A worktree under .claude/worktrees is its main clone's; others are asked.
  const roots = new Set([...dirs].map((d) => d.replace(/\/\.claude\/worktrees\/.*$/, "")).filter((d) => fs.existsSync(d)));
  for (const dir of roots) {
    const root = repoRoot(dir);
    if (root && remoteRepo(root)?.toLowerCase() === repo.toLowerCase()) return root;
  }
  return undefined;
};

const fetchPullRequest = (ref, cwd) => {
  const fields = [
    "number",
    "title",
    "author",
    "headRefName",
    "headRepository",
    "headRepositoryOwner",
    "isCrossRepository",
    "maintainerCanModify",
    "state",
    "url",
  ];

  try {
    return JSON.parse(
      execFileSync("gh", ["pr", "view", ref, "--json", fields.join(",")], {
        cwd,
        encoding: "utf8",
        stdio: ["inherit", "pipe", "inherit"],
      }),
    );
  } catch (err) {
    if (err.code === "ENOENT") {
      fail("gh not found on PATH. Install it from https://cli.github.com");
    }
    fail(`could not read pull request ${ref} (see output above)`);
  }
};

// Flat and PR-numbered rather than mirroring the branch name: head branches
// often contain slashes, which would nest worktrees inside shared parent
// directories and confuse anything listing them (worktree-done included).
const worktreeNameFor = (pr) => `pr-${pr.number}-${slugify(pr.headRefName)}`;

const worktreeHoldingBranch = (branch, cwd) => {
  const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
    cwd,
    encoding: "utf8",
  });

  // Records are blank-line separated; `worktree <path>` opens each one and
  // `branch refs/heads/<name>` appears in it only when a branch is checked out.
  const found = porcelain
    .split("\n\n")
    .map((record) => record.split("\n"))
    .find((lines) => lines.includes(`branch refs/heads/${branch}`));

  return found?.find((line) => line.startsWith("worktree "))?.slice(9);
};

const defaultRemote = (cwd) => {
  const remotes = gitOutput(["remote"], { cwd }).split("\n").filter(Boolean);
  if (!remotes.length) fail("repository has no remotes");
  return remotes.includes("origin") ? "origin" : remotes[0];
};

// The remote a fork's PR is fetched from: one already pointing at the fork,
// else one added, named after its owner (or owner-name when that is taken),
// in the protocol the base remote uses. Undefined when the fork is gone.
const forkRemote = (pr, base, root) => {
  if (!pr.headRepository) return undefined;
  const owner = pr.headRepositoryOwner.login;
  const repo = `${owner}/${pr.headRepository.name}`;
  const urlOf = (remote) => gitOutput(["config", "--get", `remote.${remote}.url`], { cwd: root });
  const remotes = gitOutput(["remote"], { cwd: root }).split("\n").filter(Boolean);
  const existing = remotes.find((remote) => urlOf(remote).match(/github\.com[:/]([^/]+\/[^/]+?)(?:\.git)?\/?$/)?.[1].toLowerCase() === repo.toLowerCase());
  if (existing) return existing;
  const name = remotes.includes(owner) ? `${owner}-${pr.headRepository.name}` : owner;
  const url = /^(git@|ssh:)/.test(urlOf(base)) ? `git@github.com:${repo}.git` : `https://github.com/${repo}.git`;
  gitRun(["remote", "add", name, url], { cwd: root });
  console.error(`Remote:   added ${name} (${url})`);
  return name;
};

const branchExists = (branch, cwd) => {
  try {
    gitRun(["show-ref", "--verify", "--quiet", `refs/heads/${branch}`], { cwd });
    return true;
  } catch {
    return false;
  }
};

// A --single-branch clone (which --depth implies) fetches only the branch it
// was cloned with, so refs/remotes/<remote>/<branch> stays unmapped: push and
// pull still work off branch.<name>.merge, but @{upstream} and ahead/behind do
// not resolve. set-branches --add widens the refspec for just this branch.
const ensureRefspecCovers = (branch, remote, root) => {
  const refspecs = (() => {
    try {
      return gitOutput(["config", "--get-all", `remote.${remote}.fetch`], {
        cwd: root,
      }).split("\n");
    } catch {
      return [];
    }
  })();

  const covered = refspecs.some(
    (spec) =>
      spec.endsWith(`:refs/remotes/${remote}/*`) ||
      spec.endsWith(`:refs/remotes/${remote}/${branch}`),
  );
  if (covered) return;

  try {
    gitRun(["remote", "set-branches", "--add", remote, branch], { cwd: root });
  } catch {
    // Not fatal — the worktree is still correct, only ahead/behind suffers.
  }
};

// An explicit refspec rather than a bare `git fetch <remote> <branch>` so the
// remote-tracking ref is always written, whatever the remote's configured
// refspec happens to be. Returns whether the remote has the branch.
const fetchBranch = (branch, remote, root) => {
  try {
    // git's stdout to fd 2 so it can't pollute anything a caller parses.
    gitRun(
      [
        "fetch",
        remote,
        `+refs/heads/${branch}:refs/remotes/${remote}/${branch}`,
      ],
      { cwd: root, stdio: ["inherit", 2, "ignore"] },
    );
    return true;
  } catch {
    return false;
  }
};

// A PR's last commit, which GitHub keeps under refs/pull/<n>/head for as long
// as the PR exists, after its branch is deleted. Returns the ref it is fetched
// to.
const fetchPullHead = (number, remote, root) => {
  const ref = `refs/remotes/${remote}/pr/${number}`;
  try {
    gitRun(["fetch", remote, `+refs/pull/${number}/head:${ref}`], { cwd: root, stdio: ["inherit", 2, "inherit"] });
  } catch {
    fail(`could not fetch PR #${number} from ${remote}: neither its branch nor refs/pull/${number}/head (see output above)`);
  }
  return ref;
};

// Written by hand rather than via `worktree add --track`: --track insists the
// start point be covered by the remote's fetch refspec, which a single-branch
// or partial clone's refspec is not, and it fails outright when it isn't.
const setUpstream = (branch, remote, remoteBranch, root) => {
  gitRun(["config", `branch.${branch}.remote`, remote], { cwd: root });
  gitRun(["config", `branch.${branch}.merge`, `refs/heads/${remoteBranch}`], {
    cwd: root,
  });
};

// Claude Code reads .claude/settings.local.json from the worktree root, not the
// main clone, and git never copies it because it is gitignored. Symlinking the
// main clone's file keeps one source of truth for personal permissions and the
// auto mode environment profile. Skipped when the worktree already has its own.
const linkLocalSettings = (root, worktreePath) => {
  const source = path.join(root, ".claude", "settings.local.json");
  const target = path.join(worktreePath, ".claude", "settings.local.json");
  if (!fs.existsSync(source) || fs.existsSync(target)) return;
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.symlinkSync(source, target);
};

// branch is the local branch, remoteBranch the PR's on remote (the fork's,
// for a fork's PR, else base, where the PR's last commit is always kept).
// They differ only for a fork's PR, whose local branch is <owner>-<branch>.
const createWorktree = (worktreePath, { branch, remoteBranch, remote, base }, root, number) => {
  const onRemote = Boolean(remote) && fetchBranch(remoteBranch, remote, root);
  // Widened only for a branch the remote has: a refspec naming one it doesn't
  // would fail every later fetch.
  if (onRemote) ensureRefspecCovers(remoteBranch, remote, root);
  const start = onRemote ? `${remote}/${remoteBranch}` : fetchPullHead(number, base, root);
  if (!onRemote) {
    console.error(`${remoteBranch} is gone from ${remote ?? "the deleted fork"}, so the worktree starts at the PR's last commit, with no upstream.`);
  }

  // A branch that already exists locally keeps its own commits; -b would refuse
  // to reuse it. Anything it is missing from the remote is picked up below.
  const existingBranch = branchExists(branch, root);
  const args = existingBranch
    ? ["worktree", "add", worktreePath, branch]
    : ["worktree", "add", ...(onRemote ? [] : ["--no-track"]), "-b", branch, worktreePath, start];

  try {
    gitRun(args, { cwd: root, stdio: ["inherit", 2, "inherit"] });
  } catch {
    fail("git worktree creation failed (see output above)");
  }

  if (!existingBranch) {
    if (onRemote) setUpstream(branch, remote, remoteBranch, root);
    return;
  }
  if (!onRemote) return;

  // Catches up a local branch left behind by an earlier run. --ff-only so a
  // branch carrying your own unpushed commits is reported, never rewritten.
  try {
    gitRun(["merge", "--ff-only", `${remote}/${remoteBranch}`], { cwd: worktreePath });
  } catch {
    console.error(
      `Note: ${branch} has diverged from ${remote}/${remoteBranch} and was left as-is.`,
    );
  }
};

const main = async () => {
  const argv = process.argv.slice(2);

  if (argv[0] === "init") {
    const shell = argv[1];
    if (!["zsh", "bash"].includes(shell)) {
      fail("init requires a shell: worktree-from-pr init <zsh|bash>");
    }
    console.log(shellFunction());
    return;
  }

  if (argv.includes("--help") || argv.includes("-h")) usage();

  const cdFileIndex = argv.indexOf("--cd-file");
  const cdFile = cdFileIndex === -1 ? undefined : argv[cdFileIndex + 1];
  if (cdFileIndex !== -1 && !cdFile) fail("--cd-file requires a path");

  const noClaude = argv.includes("--no-claude");

  // A Set of consumed indexes, so an absent --cd-file (index -1) can't swallow
  // argv[0] the way an `index !== cdFileIndex + 1` comparison would.
  const consumed = new Set(
    cdFileIndex === -1 ? [] : [cdFileIndex, cdFileIndex + 1],
  );
  const positional = argv.filter(
    (arg, index) => !consumed.has(index) && arg !== "--no-claude",
  );

  // One positional is the PR; two means an explicit path came first.
  const [targetPath, prInput] =
    positional.length === 1
      ? [DEFAULT_WORKTREE_DIR, positional[0]]
      : [positional[0], positional[1]];
  if (!prInput || !looksLikePr(prInput)) usage();

  // The worktree is made in a clone of the PR's repository, from its remote:
  // the one you are in, or, for a URL naming another repository (or given
  // from outside any), a clone of that one found among those you work in
  // (findClone), which the `wtpr` function then cd's into. A bare number is
  // a PR of the repository you are in.
  const { ref, repo } = parsePr(prInput);
  const here = repoRoot();
  let root = here;
  if (repo && (!here || remoteRepo(here)?.toLowerCase() !== repo.toLowerCase())) {
    root = findClone(repo);
    if (!root) fail(`That PR is in ${repo}, and no clone of it was found among your tabs, recent Claude sessions or the directories in your home.\nClone it, then run wtpr again.`);
    console.error(`Repo:     ${root}`);
  }
  if (!root) fail("not inside a git repository: give the PR's URL, or run this from its repository");
  const pr = fetchPullRequest(ref, root);

  // A fork's branch is on the fork, not this repo's remote, and is often its
  // main, so it is checked out as <owner>-<branch>.
  const fork = pr.isCrossRepository;
  const branch = fork ? `${pr.headRepositoryOwner.login}-${pr.headRefName}` : pr.headRefName;
  const worktreePath = path.resolve(root, targetPath, worktreeNameFor(pr));

  console.error(`PR:       #${pr.number} — ${pr.title}`);
  console.error(`Author:   ${pr.author?.login ?? "unknown"}`);
  console.error(`Branch:   ${branch}`);
  if (pr.state !== "OPEN") console.error(`State:    ${pr.state}`);
  if (fork && pr.state === "OPEN" && !pr.maintainerCanModify) {
    console.error(`Note:     ${pr.headRepositoryOwner.login} hasn't let maintainers push to the fork, so a push may be refused.`);
  }

  // Reusing rather than erroring keeps a rerun on the same PR cheap. The branch
  // check comes second because an existing worktree at our own path is already
  // holding the branch, and reporting it as "somewhere else" would be a lie.
  const existing = fs.existsSync(worktreePath)
    ? (console.error("Worktree already exists, reusing it."), worktreePath)
    : worktreeHoldingBranch(branch, root);

  // The main clone is not somewhere to send anyone: git allows a branch in one
  // worktree at a time, so there is no worktree to make, and cd'ing to the main
  // clone is a no-op for anyone already sitting in it — which reads as the tool
  // silently doing nothing.
  if (existing === root) {
    fail(
      `${branch} is already checked out in your main clone:\n` +
        `  ${root}\n` +
        "Git allows a branch in only one worktree at a time. Either work there,\n" +
        "or switch that checkout away and rerun:\n" +
        `  git -C ${root} switch <some-other-branch>`,
    );
  }

  if (existing && existing !== worktreePath) {
    console.error(`Branch is already checked out elsewhere, using that.`);
  }

  const finalPath = existing ?? worktreePath;
  console.error(`Worktree: ${finalPath}`);

  if (!existing) {
    const base = defaultRemote(root);
    const remote = fork ? forkRemote(pr, base, root) : base;
    createWorktree(worktreePath, { branch, remoteBranch: pr.headRefName, remote, base }, root, pr.number);
  }
  linkLocalSettings(root, finalPath);

  // Read by the `wtpr` shell function.
  if (cdFile) fs.writeFileSync(cdFile, `${finalPath}\n`);

  // `wtpr` launches claude itself, after cd'ing.
  if (noClaude) return;

  const claude = spawnSync("claude", [], {
    cwd: finalPath,
    stdio: "inherit",
  });

  if (claude.error?.code === "ENOENT") {
    console.error(
      `\nclaude not found on PATH. The worktree is ready at:\n  ${finalPath}`,
    );
    return;
  }
  if (claude.status) process.exit(claude.status);
};

main().catch((err) => fail(err.message));
