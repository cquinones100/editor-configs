#!/usr/bin/env node

// worktree-from-ticket [path] <ticket-id-or-url>
//
// Creates a git worktree on a new branch named after a ticket, in Linear or
// Jira as the tracker setting says, and opens claude in it. <path> defaults to
// .claude/worktrees, resolved against the main repo root so this works from
// inside an existing worktree.
//
// Needs the tracker's key: for Linear a personal API key
// (https://linear.app/settings/api), from LINEAR_API_KEY, the Keychain
// (service linear-api-key), or ~/.config/switchboard/linear.json; for
// Jira an API token, email and site, as lib/tracker/jira.js says.
//
//   worktree-from-ticket ABC-123          creates the worktree, opens claude
//   worktree-from-ticket init zsh         prints the `wt` shell function
//
// The bare command cannot change your shell's directory — no child process can.
// Eval the `init` output to get a `wt` wrapper that also cd's you in.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { tracker, idFrom } = require("../lib/tracker");

const DEFAULT_WORKTREE_DIR = ".claude/worktrees";
const SELF = fs.realpathSync(process.argv[1]);

const usage = () => {
  console.error(
    "Usage: worktree-from-ticket [path] <ticket-id-or-url> [--prompt <text>]\n" +
      "       worktree-from-ticket init <zsh|bash>\n\n" +
      "Examples:\n" +
      "  worktree-from-ticket ABC-123\n" +
      "  worktree-from-ticket .worktrees ABC-123\n" +
      '  worktree-from-ticket ABC-123 --prompt "start with the migration"\n' +
      `\nPath defaults to ${DEFAULT_WORKTREE_DIR} under the repo root.\n` +
      "--prompt adds to the prompt Claude starts with. The wt function also takes\n" +
      "it from WT_PROMPT, which it clears, so /wt can hand its text over.",
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Emitted for `eval "$(worktree-from-ticket init zsh)"`. The function is named
// `wt` rather than `worktree-from-ticket` so it can't shadow this script and
// recurse into itself.
//
// It runs the script with --no-claude, cd's, and launches claude itself. Doing
// the cd first means the shell sits in the worktree for the whole session, so
// new tmux panes and splits inherit it; if claude ran inside the script the cd
// could only happen after it exited.
//
// Inside tmux it renames the tabs once it has cd'd. tmux only does that on a
// pane focus, and the pane `wt` runs in already has the focus, so without this
// the tab would keep its old name until you switched away and back. The new
// name follows tmux/tab-label.sh: the ticket and its title, read from the
// branch.
//
// The path comes back via --cd-file rather than stdout because $( ) would make
// stdout a pipe, and anything interactive downstream would see a non-TTY.
//
// WT_PROMPT, which /wt sets on the pane it respawns, is added to the prompt
// and cleared, so a later `wt` in the same shell, or Claude's own commands,
// don't see it again.
//
// `rc`, not `status`: `status` is a read-only special variable in zsh.
const shellFunction = () => `wt() {
  local cdfile rc dir prompt
  local -a extra
  extra=()
  [ -n "\${WT_PROMPT:-}" ] && extra=(--prompt "$WT_PROMPT")
  unset WT_PROMPT
  cdfile=$(mktemp) || return 1
  ${SELF} --no-claude --cd-file "$cdfile" "\${extra[@]}" "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$cdfile"
    return $rc
  fi
  dir=$(sed -n 1p "$cdfile")
  prompt=$(sed -n 2p "$cdfile")
  rm -f "$cdfile"
  if [ ! -d "$dir" ]; then
    echo "wt: expected a worktree directory, got: $dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  if [ -n "$TMUX_PANE" ]; then
    ~/.config/tmux/window-names.sh "$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')"
  fi
  claude "$prompt"
}`;

const slugify = (text) =>
  text
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");

// Two helpers because execFileSync returns null when stdout isn't piped, so a
// single trim()-ing wrapper would throw on the inherit-stdio calls.
const gitOutput = (args) =>
  execFileSync("git", args, { encoding: "utf8" }).trim();

const gitRun = (args, options = {}) =>
  execFileSync("git", args, { stdio: "ignore", ...options });

// --git-common-dir rather than --show-toplevel: inside an existing worktree the
// latter returns that worktree, and new worktrees belong beside the main repo.
const repoRoot = () => {
  try {
    return path.resolve(gitOutput(["rev-parse", "--git-common-dir"]), "..");
  } catch {
    fail("not inside a git repository");
  }
};

// The ticket from the tracker the tracker setting names, or a reason to stop.
const fetchIssue = async (id) => {
  const provider = tracker();
  if (!provider) fail("the tracker setting is off, so there is no ticket tracker to ask");
  const issue = await provider.issue(id);
  if (!issue) fail(`no ${provider.name} issue found for ${id}`);
  return issue;
};

// Claude Code reads .claude/settings.local.json from the worktree root, not the
// main clone, and git never copies it because it is gitignored. Symlinking the
// main clone's file keeps one source of truth for personal permissions and the
// auto mode environment profile. Skipped when the worktree already has its own.
const linkLocalSettings = (root, worktreePath) => {
  const source = path.join(root, ".claude", "settings.local.json");
  const target = path.join(worktreePath, ".claude", "settings.local.json");
  if (!fs.existsSync(source) || fs.existsSync(target)) return;
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.symlinkSync(source, target);
};

// Idempotent so rerunning on the same ticket reopens the worktree instead of
// erroring: reuse the directory if it exists, and the branch if it exists.
const CLAUDE_DIR = path.join(os.homedir(), ".claude");

const isAlive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    // EPERM means it exists but belongs to someone else, which still counts.
    return err.code === "EPERM";
  }
};

// The title the session picker shows: a name given with /rename, else the
// title Claude Code generated from the first prompt. Both live in files Claude
// Code does not document, so anything unreadable just leaves the title blank.
const sessionTitle = (session) => {
  if (session.name && session.nameSource && session.nameSource !== "derived") {
    return session.name;
  }
  const projects = path.join(CLAUDE_DIR, "projects");
  const transcript = fs.existsSync(projects)
    ? fs
        .readdirSync(projects)
        .map((dir) => path.join(projects, dir, `${session.sessionId}.jsonl`))
        .find((file) => fs.existsSync(file))
    : undefined;
  if (!transcript) return session.name ?? "";
  const titles = fs
    .readFileSync(transcript, "utf8")
    .split("\n")
    .filter((line) => line.includes('"type":"ai-title"'))
    .map((line) => {
      try {
        return JSON.parse(line).aiTitle;
      } catch {
        return undefined;
      }
    })
    .filter(Boolean);
  return titles.at(-1) ?? session.name ?? "";
};

// Where the session's pane is, as tmux numbers it, so you can go straight to
// it. Blank outside tmux or when the pane has gone.
const tmuxWindow = (session) => {
  const pane = session.tmux?.match(/(%\d+)$/)?.[1];
  if (!pane) return "";
  try {
    return execFileSync(
      "tmux",
      ["display-message", "-p", "-t", pane, "#{session_name}:#{window_index}"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    ).trim();
  } catch {
    return "";
  }
};

// Claude Code writes ~/.claude/sessions/<pid>.json for every running session,
// naming its working directory. A file whose process is gone is left over from
// a session that ended without cleaning up, and is ignored.
const liveSessionsIn = (worktreePath) => {
  const dir = path.join(CLAUDE_DIR, "sessions");
  if (!fs.existsSync(dir)) return [];
  return fs
    .readdirSync(dir)
    .filter((file) => file.endsWith(".json"))
    .map((file) => {
      try {
        return JSON.parse(fs.readFileSync(path.join(dir, file), "utf8"));
      } catch {
        return undefined;
      }
    })
    .filter(
      (session) =>
        session?.sessionId &&
        session.cwd &&
        (session.cwd === worktreePath || session.cwd.startsWith(`${worktreePath}/`)) &&
        isAlive(session.pid),
    );
};

const ensureWorktree = (worktreePath, branch) => {
  if (fs.existsSync(worktreePath)) {
    // Two sessions on one ticket edit the same files and push the same branch,
    // so a worktree that already has Claude running in it is left to that one.
    const sessions = liveSessionsIn(worktreePath);
    if (sessions.length) {
      const lines = sessions.map((session) => {
        const title = sessionTitle(session);
        const where = tmuxWindow(session);
        return (
          `  Session: ${session.sessionId}\n` +
          `  Title:   ${title || "(none yet)"}` +
          (where ? `\n  Window:  ${where}` : "")
        );
      });
      fail(
        `Claude is already working on this ticket, so wt will not start another session.\n` +
          lines.join("\n\n") +
          `\nSwitch to that session, or end it and run wt again.`,
      );
    }
    console.error("Worktree already exists, reusing it.");
    return;
  }

  const branchExists = (() => {
    try {
      gitRun(["show-ref", "--verify", "--quiet", `refs/heads/${branch}`]);
      return true;
    } catch {
      return false;
    }
  })();

  const args = branchExists
    ? ["worktree", "add", worktreePath, branch]
    : ["worktree", "add", "-b", branch, worktreePath];

  try {
    // git's stdout to fd 2 so it can't pollute anything a caller parses.
    gitRun(args, { stdio: ["inherit", 2, "inherit"] });
  } catch {
    fail("git worktree creation failed (see output above)");
  }
};

const main = async () => {
  // Each --prompt and its text come out first, so text that reads as a flag
  // (`--prompt --help`) is only ever the prompt; several are joined, as when
  // the wt function adds WT_PROMPT's to one of yours.
  const argv = [];
  const prompts = [];
  const all = process.argv.slice(2);
  for (let index = 0; index < all.length; index++) {
    if (all[index] !== "--prompt") argv.push(all[index]);
    else if (index + 1 < all.length) prompts.push(all[++index]);
    else fail("--prompt requires text");
  }
  const extraText = prompts.join(" ");

  if (argv[0] === "init") {
    const shell = argv[1];
    if (!["zsh", "bash"].includes(shell)) {
      fail("init requires a shell: worktree-from-ticket init <zsh|bash>");
    }
    console.log(shellFunction());
    return;
  }

  if (argv.includes("--help") || argv.includes("-h")) usage();

  const cdFileIndex = argv.indexOf("--cd-file");
  const cdFile = cdFileIndex === -1 ? undefined : argv[cdFileIndex + 1];
  if (cdFileIndex !== -1 && !cdFile) fail("--cd-file requires a path");

  const noClaude = argv.includes("--no-claude");

  // A Set of consumed indexes, so an absent --cd-file (index -1) can't swallow
  // argv[0] the way an `index !== cdFileIndex + 1` comparison would.
  const consumed = new Set(
    cdFileIndex === -1 ? [] : [cdFileIndex, cdFileIndex + 1],
  );
  const positional = argv.filter(
    (arg, index) => !consumed.has(index) && arg !== "--no-claude",
  );

  // One positional is the ticket; two means an explicit path came first.
  const [targetPath, ticket] =
    positional.length === 1
      ? [DEFAULT_WORKTREE_DIR, positional[0]]
      : [positional[0], positional[1]];
  const id = ticket && idFrom(ticket);
  if (!id) usage();

  const issue = await fetchIssue(id);
  const branch =
    issue.branchName ?? `${issue.identifier.toLowerCase()}-${slugify(issue.title)}`;
  const root = repoRoot();
  const worktreePath = path.resolve(root, targetPath, branch);

  console.error(`Ticket:   ${issue.identifier} — ${issue.title}`);
  console.error(`Status:   ${issue.state?.name ?? "unknown"}`);
  console.error(`Branch:   ${branch}`);
  console.error(`Worktree: ${worktreePath}`);

  ensureWorktree(worktreePath, branch);
  linkLocalSettings(root, worktreePath);

  // Keyed on the state type, not its name: a workspace can call its completed
  // state anything it likes ("Shipped", say, so nothing is literally named
  // Done), while the type is one of Linear's fixed set, which
  // lib/tracker/jira.js maps Jira's status categories onto. The three closed
  // ones are completed, canceled, and duplicate. The state goes in
  // the prompt as a fact rather than something the session has to go look up,
  // and the clause is dropped entirely if Linear ever returns no state.
  const stateClause = issue.state
    ? `, which is in the "${issue.state.name}" state`
    : "";
  const isClosed = ["completed", "canceled", "duplicate"].includes(issue.state?.type);

  // What --prompt adds, made one line, since the `wt` function reads the
  // prompt back as line 2 of the cd-file.
  const extra = extraText.replace(/\s+/g, " ").trim();

  const prompt =
    `Work on ticket ${issue.identifier}${stateClause}. ` +
    (isClosed
      ? "That state is closed, so before doing anything else tell me and confirm whether we want to reopen it; " +
        "if we do, ask what needs to be done and whether the ticket should be updated to cover the new work. "
      : "") +
    "Before changing anything, read the ticket and compare it against the current state of the codebase: " +
    "is it still relevant, is it still necessary, is the approach it outlines sound, and how could it be improved? " +
    "Where the ticket gets a detail wrong — a wrong type, the wrong target directory, a file that turns out to be " +
    "unused — build what the codebase actually needs rather than stopping to ask, then update the ticket so it " +
    "matches what you built. Keep that out of the PR description: it describes the work, not the journey. " +
    "Stop and wait for my answer only when the correction is one of scope: widening the work to another file, " +
    "deleting a caller, changing an API. " +
    "Then work on the ticket. Don't run any tests, lint, or other checks when done. " +
    "When the work is done, run the /review-loop skill. " +
    "Push and create a PR when done. " +
    "Your final message has only these parts. A ticket check: \"Unchanged.\" if you didn't edit the ticket, " +
    "otherwise the edits you made to it, as tersely as possible. Then \"PR pushed\" or \"PR not pushed\", " +
    "and if not pushed, why. Then, only if the review loop stopped at its round cap, say so, " +
    "since that means it needs to run again. " +
    // How to try it, for me alone: the PR description carries no test plan.
    "Then \"Preview:\" and how to try the work in the PR's preview environment, then \"Prod:\" and how to check it " +
    "in production once it is deployed, each a few terse steps saying where to go and what to look for, changing " +
    "nothing real in production; \"None.\" for either when the work can't be seen there. " +
    "Don't summarize what changed, because I review the PR itself; " +
    "don't mention the review loop otherwise; and don't mention that tests, lint, or checks weren't run." +
    (extra ? ` Also, from me for this ticket: ${extra}` : "");

  // Read by the `wt` shell function: line 1 the worktree path, line 2 the
  // prompt. The prompt lives here so the function and the standalone path can't
  // drift apart.
  if (cdFile) fs.writeFileSync(cdFile, `${worktreePath}\n${prompt}\n`);

  // `wt` launches claude itself, after cd'ing.
  if (noClaude) return;

  const claude = spawnSync("claude", [prompt], {
    cwd: worktreePath,
    stdio: "inherit",
  });

  if (claude.error?.code === "ENOENT") {
    console.error(
      `\nclaude not found on PATH. The worktree is ready at:\n  ${worktreePath}`,
    );
    return;
  }
  if (claude.status) process.exit(claude.status);
};

main().catch((err) => fail(err.message));
