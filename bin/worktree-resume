#!/usr/bin/env node

// worktree-resume <linear-ticket-or-pr>
//
// Finds the worktree `wt` or `wtpr` already made for a Linear ticket or a
// GitHub pull request, moves your shell into it, and hands off to
// `claude-here` to resume the session that was running there. The companion to
// those two for the morning after a restart.
//
// Nothing is created and nothing is fetched: the worktree is located by
// matching the identifier against `git worktree list`, so this works offline
// and needs neither a Linear API key nor gh.
//
//   worktree-resume ABC-123                      resumes the ticket's worktree
//   worktree-resume 123                          resumes the PR's worktree
//   worktree-resume https://github.com/o/r/pull/123
//   worktree-resume init zsh                     prints the `wtr` shell function
//
// The bare command cannot change your shell's directory — no child process can.
// Eval the `init` output to get a `wtr` wrapper that also cd's you in.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");
const readline = require("node:readline");

const SELF = fs.realpathSync(process.argv[1]);

const usage = () => {
  console.error(
    "Usage: worktree-resume <linear-ticket-or-pr>\n" +
      "       worktree-resume init <zsh|bash>\n\n" +
      "Examples:\n" +
      "  worktree-resume ABC-123\n" +
      "  worktree-resume 123\n" +
      "  worktree-resume https://github.com/owner/repo/pull/123\n" +
      "  worktree-resume https://linear.app/workspace/issue/ABC-123/title",
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Emitted for `eval "$(worktree-resume init zsh)"`. The function is named
// `wtr` rather than `worktree-resume` so it can't shadow this script and
// recurse into itself.
//
// It runs the script with --no-claude, cd's, and launches claude-here itself.
// Doing the cd first means the shell sits in the worktree for the whole
// session, so new tmux panes and splits inherit it; if claude-here ran inside
// the script the cd could only happen after it exited.
//
// The path comes back via --cd-file rather than stdout because $( ) would make
// stdout a pipe, and claude-here's session picker would see a non-TTY.
//
// `rc`, not `status`: `status` is a read-only special variable in zsh.
const shellFunction = () => `wtr() {
  local cdfile rc dir
  cdfile=$(mktemp) || return 1
  ${SELF} --no-claude --cd-file "$cdfile" "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$cdfile"
    return $rc
  fi
  dir=$(sed -n 1p "$cdfile")
  rm -f "$cdfile"
  if [ ! -d "$dir" ]; then
    echo "wtr: expected a worktree directory, got: $dir" >&2
    return 1
  fi
  cd "$dir" || return 1
  claude-here
}`;

const looksLikePr = (input) =>
  /github\.com\/[^/]+\/[^/]+\/pull\/\d+/.test(input) || /^#?\d+$/.test(input);

const looksLikeTicket = (input) =>
  /\/issue\/[A-Za-z][A-Za-z0-9]*-\d+/.test(input) ||
  /^[A-Za-z][A-Za-z0-9]*-\d+$/.test(input);

// Both forms collapse to the token that `wt` and `wtpr` bake into the names
// they create: `abc-123` from the Linear branch name, `pr-123` from the
// worktree directory. Matching that token is what makes this offline — the
// identifier is already recorded on disk, so neither API has to be asked what
// the branch was called.
const parseTarget = (input) => {
  if (looksLikeTicket(input)) {
    const identifier = (input.match(/\/issue\/([A-Za-z][A-Za-z0-9]*-\d+)/)?.[1] ??
      input
    ).toLowerCase();
    return { token: identifier, label: identifier.toUpperCase(), create: `wt ${identifier.toUpperCase()}` };
  }

  if (looksLikePr(input)) {
    const number =
      input.match(/github\.com\/[^/]+\/[^/]+\/pull\/(\d+)/)?.[1] ??
      input.replace(/^#/, "");
    return { token: `pr-${number}`, label: `PR #${number}`, create: `wtpr ${number}` };
  }

  fail(`could not parse a Linear ticket or pull request from "${input}"`);
};

const gitOutput = (args, options = {}) =>
  execFileSync("git", args, { encoding: "utf8", ...options }).trim();

// --git-common-dir rather than --show-toplevel: inside an existing worktree the
// latter returns that worktree, and `worktree list` wants the main repo.
const repoRoot = () => {
  try {
    return path.resolve(gitOutput(["rev-parse", "--git-common-dir"]), "..");
  } catch {
    fail("not inside a git repository");
  }
};

const listWorktrees = (root) => {
  const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
    cwd: root,
    encoding: "utf8",
  });

  // Records are blank-line separated; `worktree <path>` opens each one and
  // `branch refs/heads/<name>` appears in it only when a branch is checked out.
  return porcelain
    .split("\n\n")
    .map((record) => record.split("\n"))
    .map((lines) => ({
      path: lines.find((line) => line.startsWith("worktree "))?.slice(9),
      branch: lines
        .find((line) => line.startsWith("branch refs/heads/"))
        ?.slice("branch refs/heads/".length),
    }))
    .filter((worktree) => worktree.path);
};

// Bounded on both sides so ABC-12 does not match abc-123, and matched against
// the branch as well as the directory: a ticket's worktree is named after its
// branch, but a PR's is named `pr-<n>-<branch>`, and either half can be the
// thing that carries the identifier.
const mentions = (text, token) =>
  !!text &&
  new RegExp(`(?:^|[^a-z0-9])${token}(?:[^a-z0-9]|$)`).test(text.toLowerCase());

const modifiedAt = (worktreePath) => {
  try {
    return fs.statSync(worktreePath).mtimeMs;
  } catch {
    return null;
  }
};

// Numbered rather than a raw-mode picker: claude-here draws its own arrow-key
// list a moment later, and two different pickers in one command is a worse
// experience than one plain prompt for a case that is already rare.
const chooseWorktree = async (matches, root) => {
  console.error(`${matches.length} worktrees match — pick one:`);
  matches.forEach((match, index) => {
    console.error(
      `  ${index + 1}. ${path.relative(root, match.path) || match.path}` +
        `${match.branch ? `  (${match.branch})` : ""}`,
    );
  });

  const prompt = readline.createInterface({
    input: process.stdin,
    output: process.stderr,
  });

  try {
    prompt.setPrompt("Select worktree [1]: ");
    prompt.prompt();
    for await (const answer of prompt) {
      const trimmed = answer.trim();
      if (trimmed === "") return matches[0];
      const index = Number(trimmed);
      if (Number.isInteger(index) && index >= 1 && index <= matches.length) {
        return matches[index - 1];
      }
      console.error(`enter a number between 1 and ${matches.length}`);
      prompt.prompt();
    }
    return matches[0];
  } finally {
    prompt.close();
  }
};

const main = async () => {
  const argv = process.argv.slice(2);

  if (argv[0] === "init") {
    const shell = argv[1];
    if (!["zsh", "bash"].includes(shell)) {
      fail("init requires a shell: worktree-resume init <zsh|bash>");
    }
    console.log(shellFunction());
    return;
  }

  if (argv.includes("--help") || argv.includes("-h")) usage();

  const cdFileIndex = argv.indexOf("--cd-file");
  const cdFile = cdFileIndex === -1 ? undefined : argv[cdFileIndex + 1];
  if (cdFileIndex !== -1 && !cdFile) fail("--cd-file requires a path");

  const noClaude = argv.includes("--no-claude");

  // A Set of consumed indexes, so an absent --cd-file (index -1) can't swallow
  // argv[0] the way an `index !== cdFileIndex + 1` comparison would.
  const consumed = new Set(
    cdFileIndex === -1 ? [] : [cdFileIndex, cdFileIndex + 1],
  );
  const positional = argv.filter(
    (arg, index) => !consumed.has(index) && arg !== "--no-claude",
  );
  if (positional.length !== 1) usage();

  const target = parseTarget(positional[0]);
  const root = repoRoot();

  const matched = listWorktrees(root).filter(
    (worktree) =>
      mentions(path.basename(worktree.path), target.token) ||
      mentions(worktree.branch, target.token),
  );

  // A worktree git still tracks but whose directory is gone is not somewhere
  // to send anyone; it is also the state `wt`/`wtpr` recover from by simply
  // being rerun, so say that rather than reporting nothing found.
  const present = matched
    .map((worktree) => ({ ...worktree, mtime: modifiedAt(worktree.path) }))
    .filter((worktree) => worktree.mtime !== null)
    .sort((a, b) => b.mtime - a.mtime);

  if (!present.length) {
    fail(
      `no worktree found for ${target.label}` +
        `${matched.length ? ", only a tracked one whose directory is gone" : ""}` +
        ` under:\n  ${root}\n` +
        `Create it with:\n  ${target.create}`,
    );
  }

  const chosen =
    present.length === 1 ? present[0] : await chooseWorktree(present, root);

  console.error(`Target:   ${target.label}`);
  if (chosen.branch) console.error(`Branch:   ${chosen.branch}`);
  console.error(`Worktree: ${chosen.path}`);

  // Read by the `wtr` shell function.
  if (cdFile) fs.writeFileSync(cdFile, `${chosen.path}\n`);

  // `wtr` launches claude-here itself, after cd'ing.
  if (noClaude) return;

  const resumed = spawnSync("claude-here", [], {
    cwd: chosen.path,
    stdio: "inherit",
  });

  if (resumed.error?.code === "ENOENT") {
    console.error(
      `\nclaude-here not found on PATH. The worktree is at:\n  ${chosen.path}`,
    );
    return;
  }
  if (resumed.status) process.exit(resumed.status);
};

main().catch((err) => fail(err.message));
