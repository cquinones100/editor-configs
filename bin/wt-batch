#!/usr/bin/env node

// wt-batch <tickets...>
//
// Opens one tmux window per Linear ticket and runs `wt <ticket>` in each, so a
// handful of tickets can be started in one go. Tickets are separated by commas,
// spaces, or both, and full Linear issue URLs work in place of identifiers.
//
//   wt-batch ABC-123 ABC-124
//   wt-batch "ABC-123, ABC-124"
//   wt-batch ABC-123, https://linear.app/team/issue/ABC-124/some-title
//
// The windows sit right after the current one, in the order given, each named
// after its ticket. Focus stays where it is; the tabs fill in behind you.
//
// `wt` is typed into each new window's interactive shell rather than run as the
// window's command, for the same reason `wt` is a shell function in the first
// place: the shell has to be the thing that cd's, so it stays in the worktree
// after claude exits and new panes split from it open there too.

const { execFileSync } = require("node:child_process");

const usage = () => {
  console.error(
    "Usage: wt-batch <tickets...>\n\n" +
      "Tickets may be separated by commas, spaces, or both.\n" +
      "Examples:\n" +
      "  wt-batch ABC-123 ABC-124\n" +
      '  wt-batch "ABC-123, ABC-124"',
  );
  process.exit(1);
};

const fail = (message) => {
  console.error(`Error: ${message}`);
  process.exit(1);
};

// Same shapes worktree-from-ticket accepts. The identifier is what gets typed
// into the shell, so the strict match below is also what keeps that line free
// of anything the shell would interpret.
const parseIdentifier = (input) => {
  const fromUrl = input.match(/\/issue\/([A-Za-z][A-Za-z0-9]*-\d+)/);
  const raw = fromUrl ? fromUrl[1] : input;
  if (!/^[A-Za-z][A-Za-z0-9]*-\d+$/.test(raw)) {
    fail(`could not parse a Linear ticket identifier from "${input}"`);
  }
  return raw.toUpperCase();
};

const tmux = (args) =>
  execFileSync("tmux", args, { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }).trim();

const main = () => {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv.includes("--help") || argv.includes("-h")) usage();

  if (!process.env.TMUX) fail("not inside a tmux session");

  // Every token is validated before any window opens, so a typo in the third
  // ticket does not leave the first two half-started.
  const tickets = [
    ...new Set(
      argv
        .flatMap((arg) => arg.split(/[\s,]+/))
        .filter(Boolean)
        .map(parseIdentifier),
    ),
  ];
  if (tickets.length === 0) usage();

  // Each window is inserted after the previous one so the order matches the
  // command line. A bare `-a` would put every window right after the current
  // one and reverse them.
  tickets.reduce((after, ticket) => {
    const windowId = tmux([
      "new-window",
      "-d",
      "-a",
      "-t",
      after,
      "-n",
      ticket,
      "-c",
      process.cwd(),
      "-P",
      "-F",
      "#{window_id}",
    ]);
    tmux(["send-keys", "-t", windowId, `wt ${ticket}`, "Enter"]);
    console.error(`Opened ${ticket} in window ${windowId}`);
    return windowId;
  }, tmux(["display-message", "-p", "#{window_id}"]));
};

main();
