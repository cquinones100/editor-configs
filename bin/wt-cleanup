#!/usr/bin/env node
const { execFileSync, spawnSync } = require('node:child_process');
const { readdirSync, realpathSync, rmSync, statSync } = require('node:fs');
const { join, relative } = require('node:path');

const USAGE = `Usage: wt-cleanup <worktree-subpath>

Lists worktrees under <repo-root>/<worktree-subpath> and prompts for which
ones to remove via an fzf multi-select. Includes both git-tracked worktrees
and untracked directories so disk state and git state can be reconciled.

Status column:
  tracked   git-tracked worktree present on disk
  orphan    git-tracked worktree whose directory is gone (will be pruned)
  untracked directory on disk that git does not know about (will be removed)

Example:
  wt-cleanup .claude/worktrees

Keys in the picker:
  Tab        toggle selection
  Enter      confirm and remove selected
  Esc / C-c  cancel
`;

function main() {
  const args = process.argv.slice(2);
  if (args.length !== 1 || ['-h', '--help'].includes(args[0])) {
    process.stderr.write(USAGE);
    return args.length === 1 ? 0 : 1;
  }
  const subpath = validateSubpath(args[0]);

  try {
    execFileSync('fzf', ['--version'], { stdio: 'ignore' });
  } catch {
    die('fzf is required but not installed');
  }

  let repoRoot;
  try {
    repoRoot = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
  } catch {
    die('not inside a git repository');
  }

  const targetDir = join(repoRoot, subpath);
  assertTargetWithinRepo(repoRoot, targetDir);
  const targetPrefix = `${targetDir}/`;

  const porcelain = execFileSync(
    'git',
    ['-C', repoRoot, 'worktree', 'list', '--porcelain'],
    { encoding: 'utf8' },
  );
  const tracked = parseWorktrees(porcelain).filter((w) => w.path.startsWith(targetPrefix));

  let diskDirs = [];
  try {
    diskDirs = readdirSync(targetDir, { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => join(targetDir, d.name));
  } catch (err) {
    if (err.code !== 'ENOENT') throw err;
  }

  const trackedPaths = new Set(tracked.map((w) => w.path));
  const entries = [
    ...tracked.map((w) => ({
      status: isDirectory(w.path) ? 'tracked' : 'orphan',
      path: w.path,
      branch: w.branch,
    })),
    ...diskDirs
    .filter((p) => !trackedPaths.has(p))
    .map((p) => ({ status: 'untracked', path: p, branch: '-' })),
  ];

  if (entries.length === 0) {
    process.stdout.write(`wt-cleanup: no worktrees or directories found under ${targetPrefix}\n`);
    return 0;
  }

  const selected = selectViaFzf(entries, repoRoot);
  if (selected.length === 0) {
    process.stdout.write('wt-cleanup: cancelled\n');
    return 0;
  }

  let failed = 0;
  let pruneNeeded = false;

  selected.forEach(({ status, path: full }) => {
    if (!full.startsWith(targetPrefix)) {
      process.stderr.write(`wt-cleanup: refusing to operate outside ${targetDir}: ${full}\n`);
      failed = 1;
      return;
    }
    const rel = relative(repoRoot, full);
    switch (status) {
      case 'tracked': {
        process.stdout.write(`Removing tracked worktree ${rel}...\n`);
        const { status: code } = spawnSync(
          'git',
          ['-C', repoRoot, 'worktree', 'remove', full],
          { stdio: 'inherit' },
        );
        if (code !== 0) {
          process.stderr.write(`  failed (use 'git worktree remove --force ${full}' if intentional)\n`);
          failed = 1;
        }
        break;
      }
      case 'orphan': {
        process.stdout.write(`Pruning orphan worktree ${rel}...\n`);
        pruneNeeded = true;
        break;
      }
      case 'untracked': {
        process.stdout.write(`Removing untracked directory ${rel}...\n`);
        try {
          rmSync(full, { recursive: true, force: true });
        } catch (err) {
          process.stderr.write(`  failed to remove ${full}: ${err.message}\n`);
          failed = 1;
        }
        break;
      }
      default: {
        process.stderr.write(`  unknown status '${status}' for ${rel} — skipping\n`);
        failed = 1;
      }
    }
  });

  if (pruneNeeded) {
    spawnSync('git', ['-C', repoRoot, 'worktree', 'prune'], { stdio: 'inherit' });
  }

  return failed;
}

try {
  process.exit(main());
} catch (err) {
  process.stderr.write(`wt-cleanup: ${err.message ?? err}\n`);
  process.exit(1);
}

function die(message) {
  process.stderr.write(`wt-cleanup: ${message}\n`);
  process.exit(1);
}

function isDirectory(path) {
  try {
    return statSync(path).isDirectory();
  } catch {
    return false;
  }
}

function validateSubpath(raw) {
  const subpath = raw.replace(/^\.\//, '').replace(/\/$/, '');
  const segments = subpath.split('/');
  if (!subpath || subpath === '.' || subpath.startsWith('/') || segments.includes('..')) {
    die(`invalid subpath: ${raw}`);
  }
  return subpath;
}

function assertTargetWithinRepo(repoRoot, targetDir) {
  let realRepoRoot;
  let realTargetDir;
  try {
    realRepoRoot = realpathSync(repoRoot);
    realTargetDir = realpathSync(targetDir);
  } catch (err) {
    if (err.code === 'ENOENT') return;
    die(`cannot resolve ${targetDir}: ${err.message}`);
  }
  if (realTargetDir === realRepoRoot || !realTargetDir.startsWith(`${realRepoRoot}/`)) {
    die(`target ${targetDir} must be a strict subdirectory of ${repoRoot}`);
  }
}

function parseWorktrees(porcelain) {
  return porcelain
    .split(/\n\n+/)
    .map((record) => {
      const worktree = { path: '', branch: '' };
      record.split('\n').forEach((line) => {
        if (line.startsWith('worktree ')) {
          worktree.path = line.slice('worktree '.length);
        } else if (line.startsWith('branch ')) {
          worktree.branch = line.slice('branch '.length).replace(/^refs\/heads\//, '');
        } else if (line === 'detached') {
          worktree.branch = '(detached)';
        }
      });
      return worktree;
    })
    .filter((w) => w.path);
}

function selectViaFzf(entries, repoRoot) {
  const lines = entries.map((entry) => {
    const rel = relative(repoRoot, entry.path);
    const display = `${entry.status.padEnd(9)}  ${rel.padEnd(60)}  ${entry.branch}`;
    return [display, entry.status, entry.path, entry.branch].join('\t');
  });

  const result = spawnSync(
    'fzf',
    [
      '--multi',
      '--delimiter=\t',
      '--with-nth=1',
      '--nth=1',
      '--prompt=worktrees to remove > ',
      '--header=Tab: toggle  Enter: confirm  Esc: cancel',
      '--height=40%',
      '--reverse',
    ],
    {
      input: lines.join('\n'),
      stdio: ['pipe', 'pipe', 'inherit'],
      encoding: 'utf8',
    },
  );

  if (result.status !== 0) return [];

  return result.stdout
    .split('\n')
    .filter((line) => line.length > 0)
    .map((line) => {
      const [, status, path, branch] = line.split('\t');
      return { status, path, branch };
    });
}

