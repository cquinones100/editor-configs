#!/usr/bin/env bash

set -e

usage() {
  cat >&2 <<EOF
Usage: wt-cleanup <worktree-subpath>

Lists worktrees under <repo-root>/<worktree-subpath> and prompts for which
ones to remove via an fzf multi-select. Includes both git-tracked worktrees
and untracked directories so disk state and git state can be reconciled.

Status column:
  tracked   git-tracked worktree present on disk
  orphan    git-tracked worktree whose directory is gone (will be pruned)
  untracked directory on disk that git does not know about (will be rm -rf'd)

Example:
  wt-cleanup .claude/worktrees

Keys in the picker:
  Tab        toggle selection
  Enter      confirm and remove selected
  Esc / C-c  cancel
EOF
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  -h|--help) usage ;;
esac

subpath="${1#./}"
subpath="${subpath%/}"

if ! command -v fzf >/dev/null 2>&1; then
  echo "wt-cleanup: fzf is required but not installed" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "wt-cleanup: not inside a git repository" >&2
  exit 1
}

target_dir="$repo_root/$subpath"
target_prefix="$target_dir/"

tracked=$(git -C "$repo_root" worktree list --porcelain | awk -v prefix="$target_prefix" '
  /^worktree / {
    path = substr($0, 10)
    branch = ""
    next
  }
  /^branch / {
    branch = substr($0, 8)
    sub(/^refs\/heads\//, "", branch)
  }
  /^detached/ {
    branch = "(detached)"
  }
  /^$/ {
    if (index(path, prefix) == 1) {
      printf "%s\t%s\n", path, branch
    }
    path = ""; branch = ""
  }
  END {
    if (path != "" && index(path, prefix) == 1) {
      printf "%s\t%s\n", path, branch
    }
  }
')

tracked_paths=()
tracked_branches=()
if [[ -n "$tracked" ]]; then
  while IFS=$'\t' read -r path branch; do
    [[ -z "$path" ]] && continue
    tracked_paths+=("$path")
    tracked_branches+=("$branch")
  done <<< "$tracked"
fi

disk_paths=()
if [[ -d "$target_dir" ]]; then
  while IFS= read -r -d '' entry; do
    disk_paths+=("$entry")
  done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type d -print0)
fi

contains() {
  local needle=$1; shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

entries=""
i=0
while (( i < ${#tracked_paths[@]} )); do
  path="${tracked_paths[$i]}"
  branch="${tracked_branches[$i]}"
  if [[ -d "$path" ]]; then
    status="tracked"
  else
    status="orphan"
  fi
  entries+="${status}"$'\t'"${path}"$'\t'"${branch}"$'\n'
  i=$((i + 1))
done

for path in "${disk_paths[@]}"; do
  if ! contains "$path" "${tracked_paths[@]}"; then
    entries+="untracked"$'\t'"${path}"$'\t'"-"$'\n'
  fi
done

if [[ -z "$entries" ]]; then
  echo "wt-cleanup: no worktrees or directories found under $target_prefix"
  exit 0
fi

# Each line: <formatted-display>\t<status>\t<full-path>\t<branch>
# fzf shows only the formatted display; we parse the trailing tab-delimited
# metadata so paths with spaces survive intact.
display=$(printf '%s' "$entries" | awk -v root="$repo_root/" -F'\t' '
  NF >= 3 {
    rel = $2
    if (substr(rel, 1, length(root)) == root) rel = substr(rel, length(root) + 1)
    printf "%-9s  %-60s  %s\t%s\t%s\t%s\n", $1, rel, $3, $1, $2, $3
  }
')

selected=$(printf '%s\n' "$display" | fzf \
  --multi \
  --delimiter=$'\t' \
  --with-nth=1 \
  --nth=1 \
  --prompt="worktrees to remove > " \
  --header="Tab: toggle  Enter: confirm  Esc: cancel" \
  --height=40% \
  --reverse) || {
  echo "wt-cleanup: cancelled"
  exit 0
}

[[ -z "$selected" ]] && { echo "wt-cleanup: nothing selected"; exit 0; }

failed=0
pruned=0
while IFS=$'\t' read -r _display status full branch; do
  [[ -z "$status" ]] && continue
  rel="${full#"$repo_root/"}"
  # Refuse anything that does not resolve under the requested target dir.
  case "$full" in
    "$target_dir"/*) ;;
    *)
      echo "wt-cleanup: refusing to operate outside $target_dir: $full" >&2
      failed=1
      continue
      ;;
  esac
  case "$status" in
    tracked)
      echo "Removing tracked worktree $rel..."
      if ! git -C "$repo_root" worktree remove "$full"; then
        echo "  failed (use 'git worktree remove --force $full' if intentional)" >&2
        failed=1
      fi
      ;;
    orphan)
      echo "Pruning orphan worktree $rel..."
      pruned=1
      ;;
    untracked)
      echo "Removing untracked directory $rel..."
      if ! rm -rf "$full"; then
        echo "  failed to rm -rf $full" >&2
        failed=1
      fi
      ;;
    *)
      echo "  unknown status '$status' for $rel — skipping" >&2
      failed=1
      ;;
  esac
done <<< "$selected"

if (( pruned )); then
  git -C "$repo_root" worktree prune
fi

exit "$failed"
