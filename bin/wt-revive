#!/usr/bin/env node

// wt-revive [--list] [<dir>]
//
// The picker behind M-o: an fzf list of worktrees that no tmux pane has open,
// to bring one back. Picking one opens a tab in it and resumes its Claude
// session with claude-here, as `wtr` does. The companion to wt-jump, which only
// jumps between tabs that are still open.
//
//   wt-revive          fzf picker, from the repository of the current directory
//   wt-revive <dir>    the same, starting from <dir>'s repository
//   wt-revive --list   print the rows instead of opening the picker
//   wt-revive --json   each row as a line of JSON, nothing when there are none:
//                      mission control's Work map (lib/sidebar/views.js) reads it
//
// Which repositories: the one <dir> is in, every open pane's, and every one a
// Claude session has run in over the last two weeks, so a repository whose tabs
// are all closed still counts. Each row is a worktree of one of them with no
// pane inside it: its repository and branch, how long since it was last used,
// and the last prompt Claude was given there, most recent first. Worktrees git
// marks prunable (their directory is gone) are left out.
//
// What a transcript says (its last directory and last prompt) is cached in
// ~/.cache/wt-revive/index.json against the file's size and modified time, and
// what repository a directory belongs to against the directory. Between two
// presses of M-o almost no transcript has changed, so a press reads only the
// few that have, rather than the end of every one: a security agent on this Mac
// inspects every process that starts, and the shell version of this started
// about a thousand to say the same thing every time.

const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const PROJECTS = path.join(os.homedir(), ".claude/projects");
const CACHE_FILE = path.join(os.homedir(), ".cache/wt-revive/index.json");
const RECENT_MS = 14 * 24 * 60 * 60 * 1000;
// The directory is on most lines of a transcript, so the end of it says where
// the session finished, and some transcripts are megabytes long.
const CWD_TAIL = 64 * 1024;
// A prompt can be followed by any amount of tool output, so the search for it
// widens until it finds one or has read the whole file.
const PROMPT_TAILS = [256 * 1024, 2 * 1024 * 1024, Infinity];
// How long a directory found to be outside any repository is believed. A
// repository's directory stays one, but a plain directory can become one.
const NOT_A_REPO_MS = 24 * 60 * 60 * 1000;

const usage = () => {
  console.error("Usage: wt-revive [--list | --json] [<dir>]");
  process.exit(1);
};

const fail = (message) => {
  console.error(message);
  process.exit(1);
};

// LC_ALL because tmux rewrites control characters in its output, tab
// delimiters included, without a UTF-8 locale.
const tmux = (args) =>
  execFileSync("tmux", args, {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
    env: { ...process.env, LC_ALL: "en_US.UTF-8" },
  }).trimEnd();

const git = (args, cwd) => {
  try {
    return execFileSync("git", ["-C", cwd, "--no-optional-locks", ...args], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return undefined;
  }
};

const readCache = () => {
  try {
    const cache = JSON.parse(fs.readFileSync(CACHE_FILE, "utf8"));
    return { transcripts: cache.transcripts ?? {}, repos: cache.repos ?? {} };
  } catch {
    return { transcripts: {}, repos: {} };
  }
};

// The cache holds prompts, so only you can read it. Written to a temporary
// file and renamed, so two popups at once never leave half a file behind.
const writeCache = (cache) => {
  fs.mkdirSync(path.dirname(CACHE_FILE), { recursive: true, mode: 0o700 });
  const temporary = `${CACHE_FILE}.${process.pid}`;
  fs.writeFileSync(temporary, JSON.stringify(cache), { mode: 0o600 });
  fs.renameSync(temporary, CACHE_FILE);
};

// The last `length` bytes of a file, from the start of a whole line unless the
// read reaches the start of the file.
const tailOf = (file, size, length) => {
  const start = Math.max(0, size - length);
  const buffer = Buffer.alloc(size - start);
  const fd = fs.openSync(file, "r");
  try {
    fs.readSync(fd, buffer, 0, buffer.length, start);
  } finally {
    fs.closeSync(fd);
  }
  const text = buffer.toString("utf8");
  return { text: start === 0 ? text : text.slice(text.indexOf("\n") + 1), whole: start === 0 };
};

// The last directory counts, since a session that started elsewhere and moved
// into a worktree belongs to the worktree.
const cwdIn = (file, size) => {
  const found = [...tailOf(file, size, CWD_TAIL).text.matchAll(/"cwd":("(?:[^"\\]|\\.)*")/g)].at(-1);
  try {
    return found ? JSON.parse(found[1]) : undefined;
  } catch {
    return undefined;
  }
};

// What you typed, not what Claude Code added: string content only (a tool
// result is a list), nothing marked meta, and nothing that starts with a tag
// (slash commands, hook output).
const promptsIn = (text) =>
  text
    .split("\n")
    .filter((line) => line.includes('"type":"user"'))
    .flatMap((line) => {
      try {
        const entry = JSON.parse(line);
        const content = entry.message?.content;
        return entry.type === "user" && !entry.isMeta && typeof content === "string"
          ? [content.replace(/[\n\t]/g, " ")]
          : [];
      } catch {
        return [];
      }
    })
    .filter((prompt) => !prompt.startsWith("<"));

// The last prompt that says something: "yes" and "go ahead" don't say what the
// worktree was for. The very last one if none does.
const promptIn = (file, size) => {
  const said = (prompts) => prompts.findLast((prompt) => prompt.length >= 20);
  const found = PROMPT_TAILS.reduce((done, length) => {
    if (done.answer !== undefined || done.whole) return done;
    const { text, whole } = tailOf(file, size, length);
    const prompts = promptsIn(text);
    const answer = said(prompts) ?? (whole ? (prompts.at(-1) ?? "") : undefined);
    return { answer, whole };
  }, { answer: undefined, whole: false });
  return [...(found.answer ?? "")].slice(0, 90).join("");
};

// Every transcript modified in the last two weeks, subagents' included, newest
// first, each with the directory it ended in. Only a file whose size or
// modified time differs from the cache's is read.
const recentSessions = (cache) => {
  let names;
  try {
    names = fs.readdirSync(PROJECTS, { recursive: true });
  } catch {
    return [];
  }
  const since = Date.now() - RECENT_MS;
  return names
    .filter((name) => name.endsWith(".jsonl"))
    .flatMap((name) => {
      const file = path.join(PROJECTS, name);
      try {
        const { mtimeMs, size } = fs.statSync(file);
        return mtimeMs > since ? [{ file, mtimeMs, size }] : [];
      } catch {
        return [];
      }
    })
    .map(({ file, mtimeMs, size }) => {
      const known = cache.transcripts[file];
      const entry =
        known?.mtimeMs === mtimeMs && known?.size === size ? known : { mtimeMs, size, cwd: cwdIn(file, size) };
      return { file, ...entry };
    })
    .filter((session) => session.cwd)
    .sort((a, b) => b.mtimeMs - a.mtimeMs);
};

// A directory's repository, as its main checkout, so each one's worktrees are
// listed once however many places point into it. A bare repository has no
// checkout of its own.
const repoOf = (dir, cache) => {
  const known = cache.repos[dir];
  if (known && (known.repo || Date.now() - known.checkedAt < NOT_A_REPO_MS)) return known.repo;
  const common = git(["rev-parse", "--path-format=absolute", "--git-common-dir"], dir);
  const repo = common && path.basename(common) === ".git" ? path.dirname(common) : null;
  cache.repos[dir] = { repo, checkedAt: Date.now() };
  return repo;
};

const worktreesOf = (repo) =>
  (git(["worktree", "list", "--porcelain"], repo) ?? "")
    .split("\n\n")
    .map((block) => block.split("\n"))
    .filter((lines) => lines[0]?.startsWith("worktree ") && !lines.some((line) => /^(prunable|bare)\b/.test(line)))
    .map((lines) => ({
      tree: lines[0].slice("worktree ".length),
      branch: lines.includes("detached")
        ? "(detached)"
        : (lines.find((line) => line.startsWith("branch "))?.slice("branch refs/heads/".length) ?? ""),
    }));

const age = (when) => {
  const s = Math.floor(Date.now() / 1000) - when;
  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
  if (s < 172800) return `${Math.floor(s / 3600)}h ago`;
  return `${Math.floor(s / 86400)}d ago`;
};

const main = () => {
  const argv = process.argv.slice(2);
  if (argv.includes("--help") || argv.includes("-h")) usage();
  const listOnly = argv.includes("--list");
  const json = argv.includes("--json");
  const positional = argv.filter((arg) => arg !== "--list" && arg !== "--json");
  if (positional.length > 1) usage();
  const dir = path.resolve(positional[0] ?? process.cwd());

  const cache = readCache();
  const sessions = recentSessions(cache);
  const panes = tmux(["list-panes", "-a", "-F", "#{pane_current_path}"]).split("\n").filter(Boolean);

  const dirs = [...new Set([dir, ...panes, ...sessions.map((session) => session.cwd)])];
  const repos = [
    ...new Set(
      dirs
        .filter((candidate) => fs.existsSync(candidate))
        .map((candidate) => repoOf(candidate, cache))
        .filter(Boolean),
    ),
  ];
  if (!repos.length) {
    if (json) return;
    fail("No git repositories found in your tabs or recent Claude sessions.");
  }

  // A worktree is open when some pane is in it or below it.
  const isOpen = (tree) => panes.some((pane) => pane === tree || pane.startsWith(`${tree}/`));

  const rows = repos
    .flatMap((repo) =>
      worktreesOf(repo)
        .filter(({ tree }) => !isOpen(tree))
        .map(({ tree, branch }) => {
          // The newest session in this worktree, or in a directory below it.
          const session = sessions.find((candidate) => candidate.cwd === tree || candidate.cwd.startsWith(`${tree}/`));
          if (session && session.prompt === undefined) session.prompt = promptIn(session.file, session.size);
          const when = session
            ? Math.floor(session.mtimeMs / 1000)
            : Math.floor((fs.statSync(tree, { throwIfNoEntry: false })?.mtimeMs ?? 0) / 1000);
          return {
            when,
            tree,
            repo,
            branch,
            label: `${path.basename(repo)} ${branch}`,
            age: age(when),
            prompt: session ? session.prompt : "(no recent Claude session)",
          };
        }),
    )
    .sort((a, b) => b.when - a.when);

  // Only what this press saw is kept, so files that age out or are deleted
  // leave the cache with them.
  writeCache({
    transcripts: Object.fromEntries(sessions.map(({ file, ...entry }) => [file, entry])),
    repos: Object.fromEntries(dirs.filter((candidate) => cache.repos[candidate]).map((candidate) => [candidate, cache.repos[candidate]])),
  });

  if (json) {
    rows.forEach((row) => console.log(JSON.stringify(row)));
    return;
  }
  if (!rows.length) fail("Every worktree already has a tab open.");
  if (listOnly) {
    rows.forEach((row) => console.log([row.label, row.age, row.prompt].join("\t")));
    return;
  }

  const picked = spawnSync(
    "fzf",
    [
      "--delimiter=\t",
      "--with-nth=2..",
      "--tabstop=2",
      "--prompt=Reopen > ",
      "--header=A worktree with no tab: Enter opens a tab and resumes its Claude",
      "--no-sort",
      "--layout=reverse",
    ],
    {
      input: rows.map((row) => [row.tree, row.label, row.age, row.prompt].join("\t")).join("\n"),
      encoding: "utf8",
      stdio: ["pipe", "pipe", "inherit"],
    },
  );
  if (picked.error?.code === "ENOENT") fail("fzf not found on PATH. Install it with\n  brew install fzf");
  const tree = picked.stdout?.split("\t")[0].trim();
  if (!tree) return;

  // claude-here finds and resumes the directory's session; an interactive zsh
  // puts it on the PATH, and leaves the tab at a shell when Claude exits.
  tmux(["new-window", "-c", tree, "zsh -i -c 'claude-here; exec zsh -i'"]);
};

main();
