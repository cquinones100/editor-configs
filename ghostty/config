# Font
font-family = MesloLGS NF
font-size = 11

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
macos-titlebar-style = native
confirm-close-surface = false

# Input
macos-option-as-alt = true

# Auto-attach to tmux on launch
command = /opt/homebrew/bin/tmux new-session -A -s main

# Disable close keybindings
keybind = super+w=unbind
keybind = super+shift+w=unbind
keybind = super+q=unbind

# Allow Cmd+Click to open links even inside tmux
mouse-shift-capture = false

# Theme override — written by tmux/theme.sh; optional so missing file is fine
config-file = ?~/.config/ghostty/theme-mode.conf
